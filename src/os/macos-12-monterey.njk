---
layout: layouts/base.njk
title: macOS Monterey - RetroOS Museum
description: Experience the macOS Monterey desktop environment with authentic design and interactive features.
bodyClass: macos-12-monterey-body
permalink: /os/macos-12-monterey/
---

{% block head %}
<!-- macOS Monterey CSS -->
<link rel="stylesheet" href="/assets/css/macos-12-monterey.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.macos-12-monterey-body header,
  body.macos-12-monterey-body footer {
    display: none;
  }

  body.macos-12-monterey-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- macOS Monterey Desktop Environment -->
<div id="macos-12-monterey-desktop" class="macos-12-monterey-desktop" role="application" aria-label="macOS Monterey Desktop">

  <!-- Global Menu Bar (Mac paradigm) -->
  <div id="macos-12-monterey-menubar" class="macos-12-monterey-menubar" role="menubar" aria-label="Menu Bar">
    <!-- Menu items will be populated by JavaScript -->
  </div>

  <!-- Desktop Area -->
  <div id="desktop-area" class="desktop-area">
    <!-- Desktop Icons Container -->
    <div id="desktop-icons" class="desktop-icons">
      <!-- Icons will be added by JavaScript -->
    </div>
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>

  <!-- Dock (for OS X and later) -->
  <div id="macos-12-monterey-dock" class="macos-12-monterey-dock">
    <!-- Dock items will be populated by JavaScript -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Systems -->
<script src="/assets/js/window-manager.js"></script>
<script src="/assets/js/menu-system.js"></script>
<script src="/assets/js/desktop.js"></script>

<!-- macOS Monterey Specific -->
<script src="/assets/js/macos-12-monterey-window-adapter.js"></script>
<script src="/assets/js/macos-12-monterey-menubar.js"></script>
<script src="/assets/js/macos-12-monterey-desktop.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/macos-12-monterey-finder.js"></script>
<script src="/assets/js/apps/macos-12-monterey-apps.js"></script>

<!-- Initialize macOS Monterey -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Load OS configuration
    fetch('/assets/data/os/macos-12-monterey.json')
      .then(response => response.json())
      .then(config => {
        // Initialize macOS Monterey desktop
        window.osInstance = new OSInstance(config);
        window.osInstance.init();
      })
      .catch(error => {
        console.error('Failed to load OS configuration:', error);
      });
  });
</script>
{% endblock %}
