---
layout: layouts/base.njk
title: Mac OS X Snow Leopard - RetroOS Museum
description: Experience the Mac OS X Snow Leopard desktop environment with authentic design and interactive features.
bodyClass: macos-x-10.6-snow-leopard-body
permalink: /os/macos-x-10.6-snow-leopard/
---

{% block head %}
<!-- Mac OS X Snow Leopard CSS -->
<link rel="stylesheet" href="/assets/css/macos-x-10.6-snow-leopard.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.macos-x-10.6-snow-leopard-body header,
  body.macos-x-10.6-snow-leopard-body footer {
    display: none;
  }

  body.macos-x-10.6-snow-leopard-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- Mac OS X Snow Leopard Desktop Environment -->
<div id="macos-x-10.6-snow-leopard-desktop" class="macos-x-10.6-snow-leopard-desktop" role="application" aria-label="Mac OS X Snow Leopard Desktop">

  <!-- Global Menu Bar (Mac paradigm) -->
  <div id="macos-x-10.6-snow-leopard-menubar" class="macos-x-10.6-snow-leopard-menubar" role="menubar" aria-label="Menu Bar">
    <!-- Menu items will be populated by JavaScript -->
  </div>

  <!-- Desktop Area -->
  <div id="desktop-area" class="desktop-area">
    <!-- Desktop Icons Container -->
    <div id="desktop-icons" class="desktop-icons">
      <!-- Icons will be added by JavaScript -->
    </div>
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>

  <!-- Dock (for OS X and later) -->
  <div id="macos-x-10.6-snow-leopard-dock" class="macos-x-10.6-snow-leopard-dock">
    <!-- Dock items will be populated by JavaScript -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Systems -->
<script src="/assets/js/window-manager.js"></script>
<script src="/assets/js/menu-system.js"></script>
<script src="/assets/js/desktop.js"></script>

<!-- Mac OS X Snow Leopard Specific -->
<script src="/assets/js/macos-x-10.6-snow-leopard-window-adapter.js"></script>
<script src="/assets/js/macos-x-10.6-snow-leopard-menubar.js"></script>
<script src="/assets/js/macos-x-10.6-snow-leopard-desktop.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/macos-x-10.6-snow-leopard-finder.js"></script>
<script src="/assets/js/apps/macos-x-10.6-snow-leopard-apps.js"></script>

<!-- Initialize Mac OS X Snow Leopard -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Load OS configuration
    fetch('/assets/data/os/macos-x-10.6-snow-leopard.json')
      .then(response => response.json())
      .then(config => {
        // Initialize Mac OS X Snow Leopard desktop
        window.osInstance = new OSInstance(config);
        window.osInstance.init();
      })
      .catch(error => {
        console.error('Failed to load OS configuration:', error);
      });
  });
</script>
{% endblock %}
