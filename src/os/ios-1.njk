---
layout: layouts/base.njk
title: iPhone OS 1.0 - RetroOS Museum
description: Experience the revolutionary iPhone OS 1.0 from 2007 - the original touch-first mobile interface with 16 apps that changed everything.
bodyClass: ios1-body
permalink: /os/ios-1/
---

{% block head %}
<!-- iOS 1 CSS -->
<link rel="stylesheet" href="/assets/css/ios1.css">
<style>
  /* Hide default header and footer for full iPhone experience */
  body.ios1-body header,
  body.ios1-body footer {
    display: none;
  }

  body.ios1-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }

  body.ios1-body {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    min-height: 100vh;
  }
</style>
{% endblock %}

{% block content %}
<!-- iOS 1.0 iPhone Device -->
<div id="ios1-device" class="ios1-device" role="application" aria-label="iPhone OS 1.0">
  <div class="device-frame">
    <!-- Screen Content -->
    <div class="device-screen">
      <!-- Status Bar -->
      <div id="ios1-statusbar" class="ios1-statusbar" role="banner" aria-label="Status Bar">
        <div class="statusbar-left">
          <span id="carrier-name" class="carrier-name">AT&T</span>
          <svg class="signal-icon" width="18" height="12" viewBox="0 0 18 12" fill="white">
            <rect x="0" y="8" width="3" height="4" rx="0.5"/>
            <rect x="5" y="6" width="3" height="6" rx="0.5"/>
            <rect x="10" y="4" width="3" height="8" rx="0.5"/>
            <rect x="15" y="2" width="3" height="10" rx="0.5"/>
          </svg>
          <svg class="wifi-icon" width="15" height="11" viewBox="0 0 15 11" fill="white">
            <path d="M7.5 3.5c2.5 0 4.5 1 6 2.5l-1 1c-1.2-1.2-3-2-5-2s-3.8.8-5 2l-1-1c1.5-1.5 3.5-2.5 6-2.5z"/>
            <circle cx="7.5" cy="9.5" r="1.5"/>
          </svg>
        </div>
        <div class="statusbar-center">
          <span id="statusbar-time" class="statusbar-time">9:41 AM</span>
        </div>
        <div class="statusbar-right">
          <svg class="battery-icon" width="25" height="12" viewBox="0 0 25 12" fill="white">
            <rect x="0.5" y="1.5" width="20" height="9" rx="2" stroke="white" stroke-width="1" fill="none"/>
            <rect x="2" y="3" width="16" height="6" fill="white"/>
            <rect x="21" y="4" width="3" height="4" rx="1" fill="white"/>
          </svg>
        </div>
      </div>

      <!-- Lock Screen -->
      <div id="ios1-lockscreen" class="ios1-lockscreen" hidden>
        <div class="lockscreen-time">
          <div id="lockscreen-hours" class="lockscreen-hours">9:41</div>
          <div id="lockscreen-date" class="lockscreen-date">Friday, June 29</div>
        </div>
        <div class="lockscreen-slider">
          <div id="slide-to-unlock" class="slide-to-unlock">
            <div class="slider-track">
              <span class="slider-text">slide to unlock</span>
              <div id="slider-button" class="slider-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                  <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Home Screen -->
      <div id="ios1-homescreen" class="ios1-homescreen">
        <!-- App Grid Container (multiple pages) -->
        <div id="app-pages-container" class="app-pages-container">
          <!-- Pages will be generated by JavaScript -->
        </div>

        <!-- Page Dots -->
        <div id="page-dots" class="page-dots">
          <!-- Dots will be generated by JavaScript -->
        </div>

        <!-- Dock -->
        <div id="ios1-dock" class="ios1-dock">
          <!-- Dock apps will be generated by JavaScript -->
        </div>
      </div>

      <!-- App Container (for opened apps) -->
      <div id="app-container" class="app-container" hidden>
        <!-- Apps will be rendered here -->
      </div>
    </div>

    <!-- Home Button -->
    <div id="home-button" class="home-button" role="button" aria-label="Home Button" tabindex="0"></div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- iOS 1 Core Systems -->
<script src="/assets/js/ios1-statusbar.js"></script>
<script src="/assets/js/ios1-lockscreen.js"></script>
<script src="/assets/js/ios1-homescreen.js"></script>
<script src="/assets/js/ios1-dock.js"></script>

<!-- iOS 1 Applications -->
<script src="/assets/js/apps/ios1-phone.js"></script>
<script src="/assets/js/apps/ios1-messages.js"></script>
<script src="/assets/js/apps/ios1-safari.js"></script>
<script src="/assets/js/apps/ios1-ipod.js"></script>
<script src="/assets/js/apps/ios1-photos.js"></script>
<script src="/assets/js/apps/ios1-settings.js"></script>

<!-- Initialize iOS 1 -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize iOS 1 systems
    if (typeof iOS1StatusBar !== 'undefined') {
      window.ios1StatusBar = new iOS1StatusBar();
      window.ios1StatusBar.init();
    }

    if (typeof iOS1LockScreen !== 'undefined') {
      window.ios1LockScreen = new iOS1LockScreen();
      window.ios1LockScreen.init();
    }

    if (typeof iOS1HomeScreen !== 'undefined') {
      window.ios1HomeScreen = new iOS1HomeScreen();
      window.ios1HomeScreen.init();
    }

    if (typeof iOS1Dock !== 'undefined') {
      window.ios1Dock = new iOS1Dock();
      window.ios1Dock.init();
    }
  });
</script>
{% endblock %}
