---
layout: layouts/base.njk
title: OS X Yosemite - RetroOS Museum
description: Experience the OS X Yosemite desktop environment with its revolutionary flat design and modern aesthetics.
bodyClass: osx-yosemite-body
permalink: /os/osx-10.10-yosemite/
---

{% block head %}
<!-- OS X Yosemite CSS -->
<link rel="stylesheet" href="/assets/css/osx-yosemite.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.osx-yosemite-body header,
  body.osx-yosemite-body footer {
    display: none;
  }

  body.osx-yosemite-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- OS X Yosemite Desktop Environment -->
<div id="osx-yosemite-desktop" class="osx-yosemite-desktop" role="application" aria-label="OS X Yosemite Desktop">

  <!-- Global Menu Bar -->
  <div id="osx-yosemite-menubar" class="osx-yosemite-menubar" role="menubar" aria-label="Menu Bar">
    <!-- Menu items will be populated by JavaScript -->
  </div>

  <!-- Desktop Area -->
  <div id="desktop-area" class="desktop-area">
    <!-- Desktop Icons Container -->
    <div id="desktop-icons" class="desktop-icons">
      <!-- Icons will be added by JavaScript -->
    </div>
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>

  <!-- Dock -->
  <div id="osx-yosemite-dock" class="osx-yosemite-dock">
    <!-- Dock items will be populated by JavaScript -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Systems -->
<script src="/assets/js/window-manager.js"></script>
<script src="/assets/js/menu-system.js"></script>
<script src="/assets/js/desktop.js"></script>

<!-- OS X Yosemite Specific -->
<script src="/assets/js/osx-yosemite-window-adapter.js"></script>
<script src="/assets/js/osx-yosemite-menubar.js"></script>
<script src="/assets/js/osx-yosemite-desktop.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/osx-yosemite-finder.js"></script>
<script src="/assets/js/apps/osx-yosemite-apps.js"></script>

<!-- Initialize OS X Yosemite -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Load OS configuration
    fetch('/assets/data/os/osx-10.10-yosemite.json')
      .then(response => response.json())
      .then(config => {
        // Initialize OS X Yosemite desktop
        window.osInstance = new OSInstance(config);
        window.osInstance.init();
      })
      .catch(error => {
        console.error('Failed to load OS configuration:', error);
      });
  });
</script>
{% endblock %}
