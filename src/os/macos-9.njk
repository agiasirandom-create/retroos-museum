---
layout: layouts/base.njk
title: Mac OS 9 - RetroOS Museum
description: Experience the final classic Mac OS with its refined Platinum interface, Sherlock 2, multiple user support, and the pinnacle of pre-OS X design.
bodyClass: macos9-body
permalink: /os/macos-9/
---

{% block head %}
<!-- Mac OS 9 CSS -->
<link rel="stylesheet" href="/assets/css/macos9.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.macos9-body header,
  body.macos9-body footer {
    display: none;
  }

  body.macos9-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- Mac OS 9 Desktop Environment -->
<div id="macos9-desktop" class="macos9-desktop" role="application" aria-label="Mac OS 9 Desktop">

  <!-- Global Menu Bar -->
  <div id="macos9-menubar" class="macos9-menubar" role="menubar" aria-label="Menu Bar">
    <!-- Menu items will be populated by JavaScript -->
  </div>

  <!-- Desktop -->
  <div id="desktop-area" class="desktop-area">
    <!-- Desktop Icons Container -->
    <div id="desktop-icons" class="desktop-icons">
      <!-- Icons will be added by JavaScript -->
    </div>
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>

  <!-- Control Strip -->
  <div id="macos9-control-strip" class="macos9-control-strip collapsed">
    <!-- Control strip modules will be added by JavaScript -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Systems -->
<script src="/assets/js/window-manager.js"></script>
<script src="/assets/js/menu-system.js"></script>
<script src="/assets/js/desktop.js"></script>

<!-- Mac OS 9 Specific -->
<script src="/assets/js/macos9-window-system.js"></script>
<script src="/assets/js/macos9-menubar.js"></script>
<script src="/assets/js/macos9-desktop.js"></script>
<script src="/assets/js/macos9-control-strip.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/macos9-finder.js"></script>
<script src="/assets/js/apps/macos9-simpletext.js"></script>
<script src="/assets/js/apps/macos9-sherlock.js"></script>
<script src="/assets/js/apps/macos9-control-panels.js"></script>
<script src="/assets/js/apps/macos9-system-profiler.js"></script>

<!-- Initialize Mac OS 9 -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Mac OS 9 desktop
    if (typeof MacOS9Desktop !== 'undefined') {
      window.macos9 = new MacOS9Desktop();
      window.macos9.init();
    } else {
      console.error('MacOS9Desktop not loaded');
    }
  });
</script>
{% endblock %}
