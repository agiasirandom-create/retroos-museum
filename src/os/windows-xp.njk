---
layout: layouts/base.njk
title: Windows XP - RetroOS Museum
description: Experience the revolutionary Windows XP desktop with its iconic Luna theme, Bliss wallpaper, and classic applications.
bodyClass: winxp-body
permalink: /os/windows-xp/
---

{% block head %}
<!-- Windows XP CSS -->
<link rel="stylesheet" href="/assets/css/winxp.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.winxp-body header,
  body.winxp-body footer {
    display: none;
  }

  body.winxp-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- Windows XP Desktop Environment -->
<div id="winxp-desktop" class="winxp-desktop" role="application" aria-label="Windows XP Desktop">
  <!-- Desktop Icons Container -->
  <div id="desktop-icons" class="desktop-icons">
    <!-- Icons will be added by JavaScript -->
  </div>

  <!-- Taskbar -->
  <div id="winxp-taskbar" class="winxp-taskbar" role="navigation" aria-label="Taskbar">
    <!-- Start Button -->
    <button id="start-button" class="start-button" aria-label="Start Menu" aria-expanded="false" aria-haspopup="true">
      <svg class="start-logo" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M3 3h8v8H3V3z" fill="#F15B2A"/>
        <path d="M13 3h8v8h-8V3z" fill="#7FBA00"/>
        <path d="M3 13h8v8H3v-8z" fill="#00A4EF"/>
        <path d="M13 13h8v8h-8v-8z" fill="#FFB900"/>
      </svg>
      <span class="start-text">start</span>
    </button>

    <!-- Quick Launch -->
    <div class="quick-launch">
      <div class="quick-launch-separator"></div>
      <!-- Quick launch icons will be added by JavaScript -->
    </div>

    <!-- Window Buttons Area -->
    <div id="taskbar-windows" class="taskbar-windows">
      <!-- Window buttons will be added dynamically -->
    </div>

    <!-- System Tray -->
    <div class="system-tray">
      <button class="show-desktop-btn" title="Show Desktop" aria-label="Show Desktop"></button>
      <div class="tray-separator"></div>
      <div class="tray-icons">
        <!-- Tray icons -->
        <span class="tray-icon" title="Volume">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 3L4 6H1v4h3l4 3V3z"/>
            <path d="M11 5c.5.5 1 1.5 1 3s-.5 2.5-1 3"/>
            <path d="M13 4c1 1 1.5 3 1.5 4s-.5 3-1.5 4"/>
          </svg>
        </span>
        <span class="tray-icon" title="Network">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <rect x="1" y="6" width="4" height="4"/>
            <rect x="6" y="6" width="4" height="4"/>
            <rect x="11" y="6" width="4" height="4"/>
          </svg>
        </span>
      </div>
      <div id="clock" class="clock" aria-live="polite" aria-atomic="true">
        <span id="clock-time">12:00 PM</span>
      </div>
    </div>
  </div>

  <!-- Start Menu (hidden by default) -->
  <div id="start-menu" class="start-menu" role="menu" aria-label="Start Menu" hidden>
    <div class="start-menu-container">
      <!-- Left Panel - User and Pinned Programs -->
      <div class="start-menu-left">
        <div class="start-menu-user">
          <div class="user-avatar"></div>
          <span class="user-name">Administrator</span>
        </div>
        <div class="start-menu-pinned">
          <!-- Pinned items will be populated by JavaScript -->
        </div>
        <div class="start-menu-separator-horizontal"></div>
        <div id="all-programs-trigger" class="start-menu-all-programs" role="menuitem">
          <span class="all-programs-text">All Programs</span>
          <span class="all-programs-arrow">▶</span>
        </div>
      </div>

      <!-- Right Panel - Places -->
      <div class="start-menu-right">
        <!-- Place items will be populated by JavaScript -->
      </div>
    </div>

    <!-- All Programs Submenu -->
    <div id="all-programs-menu" class="all-programs-menu" hidden>
      <div class="all-programs-header">
        <span class="back-arrow">◀</span>
        <span class="back-text">Back</span>
      </div>
      <div class="all-programs-items">
        <!-- Program items will be populated by JavaScript -->
      </div>
    </div>

    <!-- Footer Buttons -->
    <div class="start-menu-footer">
      <button class="start-menu-footer-btn log-off-btn">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 1a4 4 0 100 8 4 4 0 000-8zm0 10c-4 0-7 2-7 3v1h14v-1c0-1-3-3-7-3z"/>
        </svg>
        <span>Log Off</span>
      </button>
      <button class="start-menu-footer-btn turn-off-btn">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <circle cx="8" cy="8" r="7"/>
          <path d="M8 3v5" stroke="white" stroke-width="2"/>
        </svg>
        <span>Turn Off Computer</span>
      </button>
    </div>
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Systems -->
<script src="/assets/js/window-manager.js"></script>
<script src="/assets/js/menu-system.js"></script>
<script src="/assets/js/desktop.js"></script>

<!-- Windows XP Specific -->
<script src="/assets/js/winxp-taskbar.js"></script>
<script src="/assets/js/winxp-start-menu.js"></script>
<script src="/assets/js/winxp-desktop.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/winxp-notepad.js"></script>
<script src="/assets/js/apps/winxp-explorer.js"></script>
<script src="/assets/js/apps/winxp-control-panel.js"></script>
<script src="/assets/js/apps/winxp-search.js"></script>
<script src="/assets/js/apps/winxp-run.js"></script>

<!-- Initialize Windows XP -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Windows XP desktop
    if (typeof WinXPDesktop !== 'undefined') {
      window.winxp = new WinXPDesktop();
      window.winxp.init();
    } else {
      console.error('WinXPDesktop not loaded');
    }
  });
</script>
{% endblock %}
