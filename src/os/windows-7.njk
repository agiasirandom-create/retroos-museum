---
layout: layouts/base.njk
title: Windows 7 - RetroOS Museum
description: Experience Windows 7 with its beautiful Aero Glass interface, refined taskbar, and Jump Lists - peak Windows design.
bodyClass: win7-body
permalink: /os/windows-7/
---

{% block head %}
<!-- Windows 7 CSS -->
<link rel="stylesheet" href="/assets/css/win7.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.win7-body header,
  body.win7-body footer {
    display: none;
  }

  body.win7-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- Windows 7 Desktop Environment -->
<div id="win7-desktop" class="win7-desktop" role="application" aria-label="Windows 7 Desktop">
  <!-- Desktop Icons Container -->
  <div id="desktop-icons" class="desktop-icons">
    <!-- Icons will be added by JavaScript -->
  </div>

  <!-- Desktop Gadgets Sidebar -->
  <div id="gadgets-sidebar" class="gadgets-sidebar">
    <!-- Gadgets will be added by JavaScript -->
  </div>

  <!-- Taskbar -->
  <div id="win7-taskbar" class="win7-taskbar" role="navigation" aria-label="Taskbar">
    <!-- Start Button -->
    <button id="start-button" class="start-button" aria-label="Start Menu" aria-expanded="false" aria-haspopup="true">
      <svg class="start-orb" width="54" height="40" viewBox="0 0 54 40" fill="none">
        <defs>
          <radialGradient id="orb-gradient" cx="50%" cy="50%">
            <stop offset="0%" style="stop-color:#4CB3F7;stop-opacity:1" />
            <stop offset="50%" style="stop-color:#1E8CE3;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#0F5DA8;stop-opacity:1" />
          </radialGradient>
          <linearGradient id="flag-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FFFFFF;stop-opacity:0.9" />
            <stop offset="100%" style="stop-color:#E0F0FF;stop-opacity:0.9" />
          </linearGradient>
        </defs>
        <circle cx="27" cy="20" r="18" fill="url(#orb-gradient)" opacity="0.95"/>
        <path d="M20 13h6v6h-6v-6z" fill="url(#flag-gradient)"/>
        <path d="M28 13h6v6h-6v-6z" fill="url(#flag-gradient)"/>
        <path d="M20 21h6v6h-6v-6z" fill="url(#flag-gradient)"/>
        <path d="M28 21h6v6h-6v-6z" fill="url(#flag-gradient)"/>
      </svg>
    </button>

    <!-- Pinned/Running Apps Area -->
    <div id="taskbar-apps" class="taskbar-apps">
      <!-- App buttons will be added dynamically -->
    </div>

    <!-- System Tray -->
    <div class="system-tray">
      <button class="show-hidden-icons" title="Show hidden icons" aria-label="Show hidden icons">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M4 6l4 4 4-4z"/>
        </svg>
      </button>
      <div class="tray-icons">
        <!-- Tray icons -->
        <button class="tray-icon" title="Action Center" aria-label="Action Center">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 2L6 4h4l-2-2zm0 12l2-2H6l2 2zM4 6L2 8l2 2V6zm8 0v4l2-2-2-2z"/>
          </svg>
        </button>
        <button class="tray-icon" title="Network" aria-label="Network">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <rect x="1" y="8" width="3" height="6"/>
            <rect x="5" y="6" width="3" height="8"/>
            <rect x="9" y="4" width="3" height="10"/>
            <rect x="13" y="2" width="2" height="12"/>
          </svg>
        </button>
        <button class="tray-icon" title="Volume" aria-label="Volume">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 3L4 6H1v4h3l4 3V3z"/>
            <path d="M11 5c.5.5 1 1.5 1 3s-.5 2.5-1 3" stroke="currentColor" fill="none"/>
          </svg>
        </button>
      </div>
      <div id="clock" class="clock" aria-live="polite" aria-atomic="true">
        <div id="clock-time" class="clock-time">12:00 PM</div>
        <div id="clock-date" class="clock-date">1/1/2025</div>
      </div>
      <button class="show-desktop-btn" title="Show desktop" aria-label="Show desktop"></button>
    </div>
  </div>

  <!-- Start Menu (hidden by default) -->
  <div id="start-menu" class="start-menu" role="menu" aria-label="Start Menu" hidden>
    <div class="start-menu-container">
      <!-- Left Panel - Programs -->
      <div class="start-menu-left">
        <div class="start-menu-search">
          <input type="text" id="start-search" placeholder="Search programs and files" aria-label="Search programs and files">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <circle cx="6" cy="6" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M9 9l4 4" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
        <div class="start-menu-pinned">
          <!-- Pinned items will be populated by JavaScript -->
        </div>
        <div class="start-menu-separator"></div>
        <div id="all-programs-trigger" class="start-menu-all-programs" role="menuitem">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M2 4h12v2H2V4zm0 5h12v2H2V9z"/>
          </svg>
          <span>All Programs</span>
        </div>
      </div>

      <!-- Right Panel - Places -->
      <div class="start-menu-right">
        <div class="start-menu-user">
          <div class="user-avatar"></div>
          <span class="user-name">User</span>
        </div>
        <!-- Place items will be populated by JavaScript -->
      </div>
    </div>

    <!-- Footer Buttons -->
    <div class="start-menu-footer">
      <button class="shutdown-btn" aria-label="Shut down">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 2v6M4 4.5C2.5 6 2 7.5 2 9c0 3.3 2.7 6 6 6s6-2.7 6-6c0-1.5-.5-3-2-4.5"/>
        </svg>
        <span>Shut down</span>
        <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 12 12" fill="currentColor">
          <path d="M3 5l3 3 3-3z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Window Thumbnail Previews Container -->
  <div id="thumbnail-previews" class="thumbnail-previews" hidden>
    <!-- Thumbnails will be added dynamically -->
  </div>

  <!-- Aero Snap Preview -->
  <div id="snap-preview" class="snap-preview" hidden></div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>

  <!-- Aero Peek Overlay -->
  <div id="aero-peek-overlay" class="aero-peek-overlay" hidden></div>
</div>
{% endblock %}

{% block scripts %}
<!-- Windows 7 Specific -->
<script src="/assets/js/win7-aero.js"></script>
<script src="/assets/js/win7-desktop.js"></script>
<script src="/assets/js/win7-taskbar.js"></script>
<script src="/assets/js/win7-start-menu.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/win7-explorer.js"></script>
<script src="/assets/js/apps/win7-notepad.js"></script>
<script src="/assets/js/apps/win7-calc.js"></script>
<script src="/assets/js/apps/win7-gadgets.js"></script>

<!-- Initialize Windows 7 -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Windows 7 desktop
    if (typeof Win7Desktop !== 'undefined') {
      window.win7 = new Win7Desktop();
      window.win7.init();
    } else {
      console.error('Win7Desktop not loaded');
    }
  });
</script>
{% endblock %}
