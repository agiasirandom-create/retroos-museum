---
layout: layouts/base.njk
title: System 7 - RetroOS Museum
description: Experience the classic Macintosh System 7 desktop with its revolutionary global menu bar, elegant interface, and iconic applications.
bodyClass: macos7-body
permalink: /os/macos-system7/
---

{% block head %}
<!-- Mac OS System 7 CSS -->
<link rel="stylesheet" href="/assets/css/macos7.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.macos7-body header,
  body.macos7-body footer {
    display: none;
  }

  body.macos7-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- Mac OS System 7 Desktop Environment -->
<div id="macos7-desktop" class="macos7-desktop" role="application" aria-label="System 7 Desktop">

  <!-- Global Menu Bar -->
  <div id="macos7-menubar" class="macos7-menubar" role="menubar" aria-label="Menu Bar">
    <!-- Menu items will be populated by JavaScript -->
  </div>

  <!-- Desktop -->
  <div id="desktop-area" class="desktop-area">
    <!-- Desktop Icons Container -->
    <div id="desktop-icons" class="desktop-icons">
      <!-- Icons will be added by JavaScript -->
    </div>
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Systems -->
<script src="/assets/js/window-manager.js"></script>
<script src="/assets/js/menu-system.js"></script>
<script src="/assets/js/desktop.js"></script>

<!-- Mac OS 7 Specific -->
<script src="/assets/js/macos7-window-adapter.js"></script>
<script src="/assets/js/macos7-menubar.js"></script>
<script src="/assets/js/macos7-desktop.js"></script>

<!-- Applications -->
<script src="/assets/js/apps/macos7-finder.js"></script>
<script src="/assets/js/apps/macos7-simpletext.js"></script>
<script src="/assets/js/apps/macos7-control-panels.js"></script>
<script src="/assets/js/apps/macos7-stickies.js"></script>
<script src="/assets/js/apps/macos7-key-caps.js"></script>
<script src="/assets/js/apps/macos7-scrapbook.js"></script>
<script src="/assets/js/apps/macos7-puzzle.js"></script>
<script src="/assets/js/apps/macos7-alarm-clock.js"></script>

<!-- Initialize Mac OS System 7 -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Mac OS System 7 desktop
    if (typeof MacOS7Desktop !== 'undefined') {
      window.macos7 = new MacOS7Desktop();
      window.macos7.init();
    } else {
      console.error('MacOS7Desktop not loaded');
    }
  });
</script>
{% endblock %}
