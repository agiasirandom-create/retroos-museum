---
layout: layouts/base.njk
title: Windows 3.1 - RetroOS Museum
description: Experience the groundbreaking Windows 3.1 desktop with Program Manager, File Manager, and authentic 16-color VGA graphics from 1992.
bodyClass: win31-body
permalink: /os/windows-3.1/
---

{% block head %}
<!-- Windows 3.1 CSS -->
<link rel="stylesheet" href="/assets/css/win31.css">
<style>
  /* Hide default header and footer for full desktop experience */
  body.win31-body header,
  body.win31-body footer {
    display: none;
  }

  body.win31-body main {
    padding: 0;
    max-width: none;
    margin: 0;
  }
</style>
{% endblock %}

{% block content %}
<!-- Windows 3.1 Desktop Environment -->
<div id="win31-desktop" class="win31-desktop" role="application" aria-label="Windows 3.1 Desktop">
  <!-- Desktop Icons Container -->
  <div id="desktop-icons" class="desktop-icons">
    <!-- Icons will be added by JavaScript -->
  </div>

  <!-- Windows Container -->
  <div id="windows-container" class="windows-container">
    <!-- Windows will be added here by WindowManager -->
  </div>
</div>
{% endblock %}

{% block scripts %}
<!-- Core Window Manager -->
<script src="/assets/js/window-manager.js"></script>

<!-- Windows 3.1 Core Systems -->
<script src="/assets/js/win31-desktop.js"></script>
<script src="/assets/js/win31-program-manager.js"></script>

<!-- Windows 3.1 Applications -->
<script src="/assets/js/apps/win31-file-manager.js"></script>
<script src="/assets/js/apps/win31-notepad.js"></script>
<script src="/assets/js/apps/win31-control-panel.js"></script>
<script src="/assets/js/apps/win31-write.js"></script>
<script src="/assets/js/apps/win31-calc.js"></script>

<!-- Initialize Windows 3.1 -->
<script>
  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', function() {
    // Initialize Windows 3.1 desktop
    if (typeof Win31Desktop !== 'undefined') {
      window.win31 = new Win31Desktop();
      window.win31.init();
    } else {
      console.error('Win31Desktop not loaded');
    }
  });
</script>
{% endblock %}
