{
  "schema_version": "1.0.0",
  "os_id": "macosx-10.6-snow-leopard",

  "metadata": {
    "name": "Mac OS X Snow Leopard",
    "fullName": "Mac OS X 10.6 Snow Leopard",
    "version": "10.6.8",
    "company": "Apple Inc.",
    "releaseYear": 2009,
    "releaseDate": "2009-08-28",
    "description": "Refined and polished Mac OS X with no new features, just 'zero new features.' Faster, more efficient, and more stable than ever before.",
    "tagline": "The World's Most Advanced Operating System. Finely Tuned.",
    "category": "desktop_mac",
    "architecture": ["Intel"],

    "historical": {
      "significance": "First Intel-only Mac OS X. Focused on performance, stability, and efficiency rather than features. Refined Aqua interface. Microsoft Exchange support. Last version with Rosetta PowerPC emulation.",
      "marketShare": "Extremely popular for its stability and speed",
      "successor": "Mac OS X 10.7 Lion",
      "predecessor": "Mac OS X 10.5 Leopard",
      "endOfLife": "2014-02-25"
    },

    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/Mac_OS_X_Snow_Leopard"
    }
  },

