    "description": "Latest macOS with interactive widgets, Game Mode, web apps, and video conferencing features. Refined flat design with enhanced materials.",
    "tagline": "Today's Possibilities. Tomorrow's Ideas.",
    "category": "desktop_mac",
    "architecture": ["Apple Silicon", "Intel"],
    "historical": {
      "significance": "Interactive desktop widgets. Game Mode for gaming performance. Web Apps. Presenter Overlay for video calls. Enhanced Safari with Profiles. Latest evolution of flat macOS design.",
      "marketShare": "Current macOS version (as of 2024)",
      "successor": "macOS 15 Sequoia",
      "predecessor": "macOS 13 Ventura",
      "endOfLife": "Active"
    },
    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/MacOS_Sonoma"
    }
  },
  "visual": {
    "theme": {
      "colors": {
        "desktop": "#1A4265",
        "windowBackground": "#FFFFFF",
        "windowBorder": "rgba(0,0,0,0.06)",
