        "titleBarInactive": "rgba(254,254,254,0.80)",
        "titleBarText": "#1C1C1E",
        "buttonFace": "#FFFFFF",
        "buttonText": "#007AFF",
        "highlight": "#007AFF",
        "highlightText": "#FFFFFF",
        "menuBackground": "rgba(254,254,254,0.88)",
        "menuText": "#1C1C1E",
        "text": "#1C1C1E",
        "textDisabled": "#D1D1D6",
        "shadow": "rgba(0,0,0,0.12)",
