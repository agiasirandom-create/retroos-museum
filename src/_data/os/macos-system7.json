{
  "schema_version": "1.0.0",
  "os_id": "macos-system7",

  "metadata": {
    "name": "System 7",
    "fullName": "Macintosh System 7",
    "version": "7.5.5",
    "company": "Apple Computer",
    "releaseYear": 1991,
    "releaseDate": "1991-05-13",
    "description": "Classic Mac OS with color support, virtual memory, personal file sharing, and the revolutionary global menu bar interface.",
    "tagline": "The Power to Be Your Best",
    "category": "desktop_mac",
    "architecture": ["68k", "PowerPC"],

    "historical": {
      "significance": "First Mac OS with multitasking, virtual memory, and networking. Set the foundation for Mac interface design for decades.",
      "marketShare": "Dominated creative professional market in 1990s",
      "successor": "Mac OS 8",
      "predecessor": "System 6",
      "endOfLife": "1999-12-31"
    },

    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/System_7"
    }
  },

  "visual": {
    "theme": {
      "colors": {
        "desktop": "#CCCCCC",

        "windowBackground": "#FFFFFF",
        "windowBorder": "#000000",
        "windowBorderWidth": 1,

        "titleBarActive": "#FFFFFF",
        "titleBarInactive": "#FFFFFF",
        "titleBarText": "#000000",
        "titleBarTextInactive": "#808080",

        "buttonFace": "#DDDDDD",
        "buttonText": "#000000",
        "buttonHighlight": "#FFFFFF",
        "buttonShadow": "#888888",
        "buttonBorder": "#000000",

        "highlight": "#0000CC",
        "highlightText": "#FFFFFF",

        "menuBackground": "#FFFFFF",
        "menuText": "#000000",
        "menuHighlight": "#0000CC",

        "text": "#000000",
        "textDisabled": "#888888",

        "statusBar": "#DDDDDD",

        "shadow": "#000000",

        "custom": {
          "menuBarBackground": "#EEEEEE",
          "desktopPattern": "#CCCCCC",
          "scrollbarGray": "#DDDDDD",
          "windowStripes": "#CCCCCC"
        }
      },

      "typography": {
        "systemFont": {
          "family": "Chicago",
          "size": 12,
          "weight": "normal",
          "fallback": ["Geneva", "Helvetica", "sans-serif"]
        },
        "titleFont": {
          "family": "Geneva",
          "size": 9,
          "weight": "bold",
          "fallback": ["Helvetica", "sans-serif"]
        },
        "menuFont": {
          "family": "Chicago",
          "size": 12,
          "weight": "normal"
        },
        "monospaceFont": {
          "family": "Monaco",
          "size": 9,
          "weight": "normal"
        },

        "antialiasing": false,
        "subpixelRendering": false,
        "baseFontSize": 12,
        "scaleFactor": 1.0
      },

      "style": {
        "type": "classic",
        "borderStyle": "single",
        "cornerRadius": 0,

        "shadows": true,
        "shadowStyle": "simple",
        "transparency": false,
        "blur": false,

        "bevels": false,
        "gradients": false,
        "textures": true,

        "animationStyle": "instant"
      },

      "specialElements": {
        "scrollbarStyle": "classic",
        "focusIndicator": "solid_outline",
        "dragVisual": "outline"
      }
    },

    "cursor": {
      "style": "mac_arrow",
      "animated": true,
      "shadows": false,
      "customCursors": {
        "default": "cursors/arrow.png",
        "pointer": "cursors/hand.png",
        "text": "cursors/ibeam.png",
        "wait": "cursors/watch.png"
      }
    },

    "icons": {
      "style": "icon_32",
      "size": {
        "default": 32,
        "sizes": [16, 32]
      },
      "rendering": "antialiased",
      "shadow": false,
      "labelStyle": {
        "position": "below",
        "background": "transparent",
        "textColor": "#000000",
        "font": {
          "family": "Geneva",
          "size": 9
        }
      }
    },

    "sounds": {
      "enabled": true,
      "sounds": {
        "startup": "sounds/mac_startup.wav",
        "error": "sounds/sosumi.wav",
        "warning": "sounds/quack.wav",
        "notification": "sounds/simple_beep.wav",
        "trash": "sounds/drag_to_trash.wav"
      },
      "volume": 75
    },

    "wallpaper": {
      "type": "pattern",
      "value": "#CCCCCC",
      "pattern": "dots",
      "tiling": "tile",
      "overlay": true
    }
  },

  "paradigm": {
    "windowSystem": {
      "type": "stacking",

      "behavior": {
        "overlap": true,
        "resize": true,
        "minimize": false,
        "maximize": false,
        "close": true,

        "modal": true,
        "alwaysOnTop": false,
        "transparency": false,

        "multipleDocuments": false,
        "tabbed": false,
        "tiling": false
      },

      "chrome": {
        "titleBar": "classic",
        "controls": "icons",
        "controlPosition": "left",

        "buttons": {
          "close": {
            "style": "icon",
            "content": "close_box",
            "position": 1
          }
        },

        "titleAlign": "center",
        "showIcon": false,
        "showPath": false
      },

      "effects": {
        "openAnimation": "none",
        "closeAnimation": "none",

        "shadow": true,
        "blur": false,
        "wobbly": false
      }
    },

    "menuSystem": {
      "type": "global_menu",

      "menuBar": {
        "enabled": true,
        "position": "top",
        "sticky": true,
        "autoHide": false,

        "style": {
          "background": "#EEEEEE",
          "textColor": "#000000",
          "height": 20
        },

        "items": {
          "alwaysVisible": ["apple"],
          "applicationMenu": true,
          "systemMenu": false
        }
      },

      "contextMenu": {
        "enabled": true,
        "trigger": "ctrl_click",
        "style": {
          "background": "#FFFFFF",
          "borderStyle": "single"
        }
      },

      "behavior": {
        "clickToOpen": true,
        "keyboardShortcuts": true,
        "mnemonics": false,
        "icons": true,
        "cascading": true,
        "tearOff": false
      }
    },

    "taskManagement": {
      "type": "none",

      "switching": {
        "method": ["window_list"],
        "altTab": {
          "enabled": false
        }
      },

      "multitasking": {
        "preemptive": false,
        "virtual_desktops": false,
        "snapAssist": false,
        "splitScreen": false
      }
    },

    "desktop": {
      "type": "spatial",

      "layout": {
        "type": "free_form",
        "direction": "vertical",
        "alignment": "right",
        "snapToGrid": true,
        "autoArrange": false
      },

      "items": {
        "icons": true,
        "widgets": false,
        "shortcuts": true,
        "folders": true,

        "defaultItems": [
          "macintosh_hd",
          "trash"
        ]
      },

      "interaction": {
        "click": "single",
        "selection": "rubber_band",
        "dragAndDrop": true,
        "hoverPreview": false
      },

      "behavior": {
        "showTrash": true,
        "showComputer": true,
        "showNetwork": true,
        "showHome": false
      }
    },

    "inputMethods": {
      "keyboard": {
        "shortcuts": true,
        "function_keys": true,
        "navigation": "arrows",
        "accessibility": true
      },

      "mouse": {
        "buttons": 1,
        "scroll": "none",
        "gestures": false,
        "acceleration": true
      },

      "touch": {
        "enabled": false
      }
    }
  },

  "components": {
    "core": {
      "windowManager": "system7-window-manager",
      "fileManager": "finder",

      "optional": {
        "menuBar": "system7-menu-bar",
        "textEditor": "teachtext",
        "imageViewer": "simpletext"
      }
    },

    "applications": [
      {
        "id": "macintosh_hd",
        "name": "Macintosh HD",
        "icon": "icons/hard_drive.png",
        "type": "system",
        "component": "Finder",

        "window": {
          "title": "Macintosh HD",
          "width": 512,
          "height": 342,
          "resizable": true,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        },

        "desktop": {
          "icon": true,
          "position": { "x": 550, "y": 20 }
        },

        "features": {
          "saveState": true,
          "multiInstance": true
        }
      },
      {
        "id": "trash",
        "name": "Trash",
        "icon": "icons/trash_empty.png",
        "type": "system",
        "component": "Trash",

        "window": {
          "title": "Trash",
          "width": 512,
          "height": 342,
          "resizable": true,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        },

        "desktop": {
          "icon": true,
          "position": { "x": 550, "y": 430 }
        }
      },
      {
        "id": "teachtext",
        "name": "TeachText",
        "icon": "icons/teachtext.png",
        "type": "productivity",
        "component": "TeachText",

        "window": {
          "title": "Untitled",
