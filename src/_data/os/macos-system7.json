          "height": 320,
          "minWidth": 200,
          "minHeight": 150,
          "resizable": true,
          "minimizable": false,
          "maximizable": false,
          "position": "cascade"
        },

        "features": {
          "multiInstance": true,
          "fileAssociations": [".txt", ".text"]
        }
      },
      {
        "id": "stickies",
        "name": "Stickies",
        "icon": "icons/stickies.png",
        "type": "utility",
        "component": "Stickies",

        "window": {
          "title": "",
          "width": 200,
          "height": 150,
          "resizable": true,
          "minimizable": false,
          "maximizable": false,
          "position": "cascade"
        },

        "features": {
          "multiInstance": true
        }
      },
      {
        "id": "puzzle",
        "name": "Puzzle",
        "icon": "icons/puzzle.png",
        "type": "game",
        "component": "Puzzle",

        "window": {
          "title": "Puzzle",
          "width": 256,
          "height": 256,
          "resizable": false,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        },

        "features": {
          "multiInstance": false
        }
      },
      {
        "id": "calculator",
        "name": "Calculator",
        "icon": "icons/calculator.png",
        "type": "utility",
        "component": "Calculator",

        "window": {
          "title": "Calculator",
          "width": 200,
          "height": 180,
          "resizable": false,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        },

        "features": {
          "multiInstance": false
        }
      },
      {
        "id": "control_panels",
        "name": "Control Panels",
        "icon": "icons/control_panels.png",
        "type": "system",
        "component": "ControlPanels",

        "window": {
          "title": "Control Panels",
          "width": 400,
          "height": 300,
          "resizable": true,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        }
      },
      {
        "id": "chooser",
        "name": "Chooser",
        "icon": "icons/chooser.png",
        "type": "system",
        "component": "Chooser",

        "window": {
          "title": "Chooser",
          "width": 400,
          "height": 250,
          "resizable": false,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        }
      },
      {
        "id": "key_caps",
        "name": "Key Caps",
        "icon": "icons/key_caps.png",
        "type": "utility",
        "component": "KeyCaps",

        "window": {
          "title": "Key Caps",
          "width": 450,
          "height": 200,
          "resizable": false,
          "minimizable": false,
          "maximizable": false,
          "position": "center"
        }
      }
    ],

    "utilities": [
      {
        "id": "apple_menu",
        "name": "Apple Menu",
        "type": "system_preference",
        "icon": "icons/apple.png",
        "component": "AppleMenu"
      },
      {
        "id": "general_controls",
        "name": "General Controls",
        "type": "control_panel",
        "icon": "icons/general_controls.png",
        "component": "GeneralControls"
      },
      {
        "id": "monitors",
        "name": "Monitors",
        "type": "control_panel",
        "icon": "icons/monitors.png",
        "component": "Monitors"
      }
    ]
  },

  "features": {
    "interaction": {
      "dragAndDrop": true,
      "clipboard": true,
      "undo": true,

      "fileOperations": {
        "copy": true,
        "move": true,
        "delete": true,
        "rename": true,
        "properties": true
      },

      "networking": {
        "enabled": true,
        "protocols": ["AppleTalk", "TCP/IP"]
      },

      "printing": true,
      "scanning": false
    },

    "animations": {
      "enabled": false,
      "speed": "normal",

      "effects": {
        "windowOpen": false,
        "windowClose": false,
        "menuOpen": false,
        "hover": false,
        "transitions": false
      }
    },

    "accessibility": {
      "highContrast": false,
      "screenReader": false,
      "magnifier": false,
      "keyboard_navigation": true
    },

    "easterEggs": {
      "enabled": true,
      "list": ["secret_about", "puzzle_cheat"]
    },

    "customization": {
      "themes": false,
      "wallpaper": true,
      "colors": true,
      "fonts": false,
      "layout": true
    }
  },

  "assets": {
    "basePath": "/assets/os/system7",

    "paths": {
      "icons": "icons",
      "cursors": "cursors",
      "sounds": "sounds",
      "fonts": "fonts",
      "wallpapers": "patterns"
    },

    "iconSets": {
      "default": {
        "path": "icons",
        "format": "png",
        "sizes": [16, 32]
      }
    },

    "cursorSets": {
      "default": {
        "path": "cursors",
        "format": "png",
        "animated": true
      }
    },

    "soundSets": {
      "default": {
        "path": "sounds",
        "format": "wav"
      }
    },

    "fonts": {
      "chicago": {
        "path": "fonts/chicago.woff2",
        "format": "woff2",
        "weights": [400]
      },
      "geneva": {
        "path": "fonts/geneva.woff2",
        "format": "woff2",
        "weights": [400, 700]
      },
      "monaco": {
        "path": "fonts/monaco.woff2",
        "format": "woff2",
        "weights": [400]
      }
    },

    "preload": [
      "icons/hard_drive.png",
      "icons/trash_empty.png",
      "icons/folder.png",
      "icons/apple.png",
      "cursors/arrow.png",
      "sounds/mac_startup.wav"
    ]
  }
}
