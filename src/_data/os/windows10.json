{
  "schema_version": "1.0.0",
  "os_id": "windows-10",
  "metadata": {
    "name": "Windows 10",
    "fullName": "Microsoft Windows 10",
    "version": "10.0.19045",
    "company": "Microsoft Corporation",
    "releaseYear": 2015,
    "releaseDate": "2015-07-29",
    "description": "Modern, unified OS bringing back the Start Menu, introducing Cortana, and Windows as a Service with continuous updates.",
    "tagline": "A More Human Way to Do",
    "category": "desktop_windows",
    "architecture": ["x86", "x64", "ARM64"],
    "historical": {
      "significance": "Unified Windows across devices, introduced Windows as a Service, brought back Start Menu after Windows 8 backlash",
      "marketShare": "Dominant desktop OS from 2015-2022, over 75% market share at peak",
      "successor": "Windows 11",
      "predecessor": "Windows 8.1",
      "endOfLife": "2025-10-14"
    },
    "links": {"wikipedia": "https://en.wikipedia.org/wiki/Windows_10"}
  },
  "visual": {
    "theme": {
      "colors": {
        "desktop": "#000000",
        "windowBackground": "#FFFFFF",
        "windowBorder": "#0078D7",
        "windowBorderWidth": 1,
        "titleBarActive": "#FFFFFF",
        "titleBarInactive": "#F0F0F0",
        "titleBarText": "#000000",
        "titleBarTextInactive": "#707070",
        "buttonFace": "#FFFFFF",
        "buttonText": "#000000",
        "buttonHighlight": "#E5F3FF",
        "buttonShadow": "#E0E0E0",
        "buttonBorder": "#0078D7",
        "highlight": "#0078D7",
        "highlightText": "#FFFFFF",
        "menuBackground": "#FFFFFF",
        "menuText": "#000000",
        "text": "#000000",
        "taskbar": "#1E1E1E",
        "shadow": "rgba(0, 0, 0, 0.26)"
      },
      "typography": {
        "systemFont": {"family": "Segoe UI", "size": 12, "weight": "400", "fallback": ["Arial", "sans-serif"]},
        "titleFont": {"family": "Segoe UI", "size": 12, "weight": "600"},
        "menuFont": {"family": "Segoe UI", "size": 12, "weight": "400"},
        "monospaceFont": {"family": "Consolas", "size": 10, "weight": "normal"},
        "antialiasing": true,
        "subpixelRendering": true,
        "baseFontSize": 12,
        "scaleFactor": 1.0
      },
      "style": {
        "type": "flat",
        "borderStyle": "single",
        "cornerRadius": 0,
        "shadows": true,
        "shadowStyle": "simple",
        "transparency": true,
        "blur": false,
        "bevels": false,
        "gradients": false,
        "textures": false,
        "animationStyle": "ease"
      },
      "specialElements": {"scrollbarStyle": "thin", "focusIndicator": "solid_outline", "dragVisual": "full"}
    },
    "cursor": {"style": "modern_arrow", "animated": true, "shadows": false},
    "icons": {
      "style": "flat_modern",
      "size": {"default": 48, "sizes": [16, 32, 48, 256]},
      "rendering": "vector",
      "shadow": false,
      "labelStyle": {"position": "below", "background": "solid", "backgroundColor": "rgba(0, 0, 0, 0.5)", "textColor": "#FFFFFF", "font": {"family": "Segoe UI", "size": 9}}
    },
    "sounds": {
      "enabled": true,
      "sounds": {"startup": "sounds/startup.wav", "shutdown": "sounds/shutdown.wav", "notification": "sounds/notify.wav"},
      "volume": 80
    },
    "wallpaper": {"type": "image", "value": "wallpapers/hero.jpg", "tiling": "stretch", "overlay": true}
  },
  "paradigm": {
    "windowSystem": {
      "type": "stacking",
      "behavior": {"overlap": true, "resize": true, "minimize": true, "maximize": true, "close": true, "modal": true, "alwaysOnTop": true, "transparency": true, "multipleDocuments": false, "tabbed": false, "tiling": true},
      "chrome": {
        "titleBar": "classic",
        "controls": "buttons",
        "controlPosition": "right",
        "buttons": {
          "minimize": {"style": "icon", "content": "minimize", "position": 1},
          "maximize": {"style": "icon", "content": "maximize", "position": 2},
          "close": {"style": "icon", "content": "close", "position": 3, "hoverColor": "#E81123"}
        },
        "titleAlign": "left",
        "showIcon": true,
        "showPath": false
      },
      "effects": {"openAnimation": "fade", "closeAnimation": "fade", "shadow": true, "blur": false}
    },
    "menuSystem": {
      "type": "hybrid",
      "menuBar": {"enabled": true, "position": "window", "style": {"background": "#FFFFFF", "textColor": "#000000", "height": 28}},
      "contextMenu": {"enabled": true, "trigger": "right_click", "style": {"background": "#FFFFFF", "borderStyle": "shadow"}},
      "behavior": {"clickToOpen": true, "keyboardShortcuts": true, "icons": true, "cascading": true}
    },
    "taskManagement": {
      "type": "taskbar",
      "taskbar": {
        "enabled": true,
        "position": "bottom",
        "autoHide": false,
        "size": 40,
        "style": {"background": "#1E1E1E", "transparency": true, "blur": true, "itemStyle": "icons", "grouping": true, "previews": true},
        "sections": {"start": true, "quick_launch": false, "tasks": true, "system_tray": true, "clock": true}
      },
      "switching": {"method": ["alt_tab", "taskbar_click"], "altTab": {"enabled": true, "visual": "thumbnails", "animation": true}, "expose": {"enabled": true, "layout": "grid"}},
      "multitasking": {"preemptive": true, "virtual_desktops": true, "snapAssist": true, "splitScreen": true}
    },
    "desktop": {
      "type": "iconic",
      "layout": {"type": "grid", "grid": {"cellWidth": 75, "cellHeight": 100, "spacing": 10}, "direction": "vertical", "alignment": "left", "snapToGrid": true, "autoArrange": false},
      "items": {"icons": true, "widgets": false, "shortcuts": true, "folders": true, "defaultItems": ["this_pc", "recycle_bin", "network"]},
      "interaction": {"click": "double", "selection": "rubber_band", "dragAndDrop": true, "hoverPreview": true},
      "behavior": {"showTrash": true, "showComputer": true, "showNetwork": true}
    },
    "inputMethods": {
      "keyboard": {"shortcuts": true, "function_keys": true, "navigation": "arrows", "accessibility": true},
      "mouse": {"buttons": 5, "scroll": "wheel", "gestures": false, "acceleration": true},
      "touch": {"enabled": true, "multitouch": true, "gestures": ["tap", "swipe", "pinch", "rotate"]}
    }
  },
  "components": {
    "core": {
      "windowManager": "windows10-window-manager",
      "fileManager": "file-explorer",
      "optional": {"taskbar": "windows10-taskbar", "terminal": "command-prompt", "textEditor": "notepad", "mediaPlayer": "groove-music", "webBrowser": "microsoft-edge"}
    },
    "applications": [
      {"id": "this_pc", "name": "This PC", "icon": "icons/this_pc.png", "type": "system", "component": "FileExplorer", "window": {"title": "This PC", "width": 1000, "height": 700, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}, "desktop": {"icon": true, "position": {"x": 0, "y": 0}}},
      {"id": "recycle_bin", "name": "Recycle Bin", "icon": "icons/recycle_bin_empty.png", "type": "system", "component": "RecycleBin", "window": {"title": "Recycle Bin", "width": 1000, "height": 700, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}, "desktop": {"icon": true, "position": {"x": 0, "y": 100}}},
      {"id": "edge", "name": "Microsoft Edge", "icon": "icons/edge.png", "type": "web", "component": "Edge", "window": {"title": "Microsoft Edge", "width": 1200, "height": 800, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "notepad", "name": "Notepad", "icon": "icons/notepad.png", "type": "productivity", "component": "Notepad", "window": {"title": "Notepad", "width": 800, "height": 650, "resizable": true, "minimizable": true, "maximizable": true, "position": "cascade"}},
      {"id": "calculator", "name": "Calculator", "icon": "icons/calculator.png", "type": "utility", "component": "Calculator", "window": {"title": "Calculator", "width": 350, "height": 500, "resizable": false, "minimizable": true, "maximizable": false, "position": "center"}},
      {"id": "photos", "name": "Photos", "icon": "icons/photos.png", "type": "media", "component": "Photos", "window": {"title": "Photos", "width": 1000, "height": 750, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "paint_3d", "name": "Paint 3D", "icon": "icons/paint3d.png", "type": "creative", "component": "Paint3D", "window": {"title": "Paint 3D", "width": 1100, "height": 800, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}}
    ],
    "utilities": [
      {"id": "settings", "name": "Settings", "type": "system_preference", "icon": "icons/settings.png"},
      {"id": "cortana", "name": "Cortana", "type": "system_preference", "icon": "icons/cortana.png"}
    ]
  },
  "features": {
    "interaction": {"dragAndDrop": true, "clipboard": true, "undo": true, "fileOperations": {"copy": true, "move": true, "delete": true, "rename": true, "properties": true}, "networking": {"enabled": true, "protocols": ["TCP/IP", "IPv6"]}, "printing": true, "scanning": true},
    "animations": {"enabled": true, "speed": "normal", "effects": {"windowOpen": true, "windowClose": true, "windowMinimize": true, "minimize": true, "maximize": true, "menuOpen": true, "hover": true, "click": true, "transitions": true}},
    "accessibility": {"highContrast": true, "screenReader": true, "magnifier": true, "keyboard_navigation": true, "colorblindModes": ["protanopia", "deuteranopia", "tritanopia"]},
    "easterEggs": {"enabled": false, "list": []},
    "customization": {"themes": true, "wallpaper": true, "colors": true, "fonts": false, "layout": true}
  },
  "assets": {
    "basePath": "/assets/os/windows10",
    "paths": {"icons": "icons", "cursors": "cursors", "sounds": "sounds", "fonts": "fonts", "wallpapers": "wallpapers"},
    "iconSets": {"default": {"path": "icons", "format": "svg", "sizes": [16, 32, 48, 256]}},
    "fonts": {"segoe_ui": {"path": "fonts/segoe-ui.woff2", "format": "woff2", "weights": [300, 400, 600, 700]}},
    "preload": ["icons/this_pc.png", "sounds/startup.wav", "wallpapers/hero.jpg"]
  }
}
