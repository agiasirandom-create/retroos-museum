          "title": "Safari",
          "width": 1200,
          "height": 800,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        }
      },
      {
        "id": "messages",
        "name": "Messages",
        "icon": "icons/messages.png",
        "type": "communication",
        "component": "Messages",
        "window": {
          "title": "Messages",
          "width": 450,
          "height": 650,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        }
      }
    ],
    "utilities": [
      {
        "id": "system_preferences",
        "name": "System Preferences",
