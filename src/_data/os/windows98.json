{
  "schema_version": "1.0.0",
  "os_id": "windows-98",

  "metadata": {
    "name": "Windows 98",
    "fullName": "Microsoft Windows 98",
    "version": "4.10.1998",
    "company": "Microsoft Corporation",
    "releaseYear": 1998,
    "releaseDate": "1998-06-25",
    "description": "Enhanced version of Windows 95 with better USB support, Internet Explorer integration, and improved stability for the internet age.",
    "tagline": "Works Better, Plays Better",
    "category": "desktop_windows",
    "architecture": ["x86"],

    "historical": {
      "significance": "Refined the Windows 95 paradigm with better hardware support and internet integration",
      "marketShare": "Dominated consumer market alongside Windows 95 until Windows XP",
      "successor": "Windows ME / Windows 2000",
      "predecessor": "Windows 95",
      "endOfLife": "2006-07-11"
    },

    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/Windows_98"
    }
  },

  "visual": {
    "theme": {
      "colors": {
        "desktop": "#008080",

        "windowBackground": "#C0C0C0",
        "windowBorder": "#000000",
        "windowBorderWidth": 1,

        "titleBarActive": "#0A246A",
        "titleBarInactive": "#808080",
        "titleBarText": "#FFFFFF",
        "titleBarTextInactive": "#C0C0C0",

        "buttonFace": "#C0C0C0",
        "buttonText": "#000000",
        "buttonHighlight": "#FFFFFF",
        "buttonShadow": "#808080",
        "buttonBorder": "#000000",

        "highlight": "#0A246A",
        "highlightText": "#FFFFFF",

        "menuBackground": "#C0C0C0",
        "menuText": "#000000",
        "menuHighlight": "#0A246A",

        "text": "#000000",
        "textDisabled": "#808080",

        "statusBar": "#C0C0C0",
        "taskbar": "#C0C0C0",

        "shadow": "#000000"
      },

      "typography": {
        "systemFont": {
          "family": "MS Sans Serif",
          "size": 11,
          "weight": "normal",
          "fallback": ["Arial", "Helvetica", "sans-serif"]
        },
        "titleFont": {
          "family": "MS Sans Serif",
          "size": 11,
          "weight": "bold",
          "fallback": ["Arial", "Helvetica", "sans-serif"]
        },
        "menuFont": {
          "family": "MS Sans Serif",
          "size": 11,
          "weight": "normal"
        },
        "monospaceFont": {
          "family": "Courier New",
          "size": 10,
          "weight": "normal"
        },

        "antialiasing": false,
        "subpixelRendering": false,
        "baseFontSize": 11,
        "scaleFactor": 1.0
      },

      "style": {
        "type": "bevel_3d",
        "borderStyle": "bevel_out",
        "cornerRadius": 0,

        "shadows": false,
        "transparency": false,
        "blur": false,

        "bevels": true,
        "gradients": false,
        "textures": false,

        "animationStyle": "instant"
      },

      "specialElements": {
        "scrollbarStyle": "classic",
        "focusIndicator": "dotted_outline",
        "dragVisual": "outline"
      }
    },

    "cursor": {
      "style": "classic_arrow",
      "animated": true,
      "shadows": false
    },

    "icons": {
      "style": "icon_32",
      "size": {
        "default": 32,
        "sizes": [16, 32, 48]
      },
      "rendering": "aliased",
      "shadow": false,
      "labelStyle": {
        "position": "below",
        "background": "transparent",
        "textColor": "#FFFFFF",
        "font": {
          "family": "MS Sans Serif",
          "size": 8
        }
      }
    },

    "sounds": {
      "enabled": true,
      "sounds": {
        "startup": "sounds/startup.wav",
        "shutdown": "sounds/shutdown.wav",
        "error": "sounds/chord.wav",
        "warning": "sounds/chord.wav",
        "notification": "sounds/notify.wav",
        "click": "sounds/click.wav",
        "windowOpen": "sounds/open.wav",
        "windowClose": "sounds/close.wav",
        "trash": "sounds/recycle.wav"
      },
      "volume": 80
    },

    "wallpaper": {
      "type": "solid",
      "value": "#008080",
      "pattern": "none",
      "tiling": "tile",
      "overlay": true
    }
  },

  "paradigm": {
    "windowSystem": {
      "type": "stacking",

      "behavior": {
        "overlap": true,
        "resize": true,
        "minimize": true,
        "maximize": true,
        "close": true,

        "modal": true,
        "alwaysOnTop": true,
        "transparency": false,

        "multipleDocuments": false,
        "tabbed": false,
        "tiling": false
      },

      "chrome": {
        "titleBar": "classic",
        "controls": "buttons",
        "controlPosition": "right",

        "buttons": {
          "minimize": {
            "style": "icon",
            "content": "minimize",
            "position": 1
          },
          "maximize": {
            "style": "icon",
            "content": "maximize",
            "position": 2
          },
          "close": {
            "style": "icon",
            "content": "close",
            "position": 3
          },
          "help": {
            "style": "icon",
            "content": "help",
            "position": 0
          }
        },

        "titleAlign": "left",
        "showIcon": true,
        "showPath": false
      },

      "effects": {
        "openAnimation": "none",
        "closeAnimation": "none",
        "minimizeAnimation": "none",
        "maximizeAnimation": "none",

        "shadow": false,
        "blur": false,
        "wobbly": false
      }
    },

    "menuSystem": {
      "type": "hybrid",

      "menuBar": {
        "enabled": true,
        "position": "window",
        "sticky": false,
        "autoHide": false,

        "style": {
          "background": "#C0C0C0",
          "textColor": "#000000",
          "height": 20
        },

        "items": {
          "applicationMenu": false,
          "systemMenu": false
        }
      },

      "contextMenu": {
        "enabled": true,
        "trigger": "right_click",
        "style": {
          "background": "#C0C0C0",
          "borderStyle": "bevel_out"
        }
      },

      "behavior": {
        "clickToOpen": true,
        "keyboardShortcuts": true,
        "mnemonics": true,
        "icons": false,
        "cascading": true,
        "tearOff": false
      }
    },

    "taskManagement": {
      "type": "taskbar",

      "taskbar": {
        "enabled": true,
        "position": "bottom",
        "autoHide": false,
        "size": 28,

        "style": {
          "background": "#C0C0C0",
          "transparency": false,
          "blur": false,
          "itemStyle": "icons_and_labels",
          "grouping": false,
          "previews": false
        },

        "sections": {
          "start": true,
          "quick_launch": true,
          "tasks": true,
          "system_tray": true,
          "clock": true
        }
      },

      "switching": {
        "method": ["alt_tab", "taskbar_click"],
        "altTab": {
          "enabled": true,
          "visual": "icons",
          "animation": false
        }
      },

      "multitasking": {
        "preemptive": true,
        "virtual_desktops": false,
        "snapAssist": false,
        "splitScreen": false
      }
    },

    "desktop": {
      "type": "iconic",

      "layout": {
        "type": "grid",
        "grid": {
          "cellWidth": 80,
          "cellHeight": 80,
          "spacing": 8
        },
        "direction": "vertical",
        "alignment": "left",
        "snapToGrid": true,
        "autoArrange": false
      },

      "items": {
        "icons": true,
        "widgets": false,
        "shortcuts": true,
        "folders": true,

        "defaultItems": [
          "my_computer",
          "my_documents",
          "network_neighborhood",
          "recycle_bin",
          "internet_explorer",
          "online_services"
        ]
      },

      "interaction": {
        "click": "double",
        "selection": "rubber_band",
        "dragAndDrop": true,
        "hoverPreview": false
      },

      "behavior": {
        "showTrash": true,
        "showComputer": true,
        "showNetwork": true,
        "showHome": false
      }
    },

    "inputMethods": {
      "keyboard": {
        "shortcuts": true,
        "function_keys": true,
        "navigation": "arrows",
        "accessibility": true
      },

      "mouse": {
        "buttons": 2,
        "scroll": "wheel",
        "gestures": false,
        "acceleration": true
      },

      "touch": {
        "enabled": false
      }
    }
  },

  "components": {
    "core": {
      "windowManager": "windows98-window-manager",
      "fileManager": "windows-explorer",

      "optional": {
        "taskbar": "windows98-taskbar",
        "terminal": "command-prompt",
        "textEditor": "notepad",
        "imageViewer": "paint",
        "mediaPlayer": "windows-media-player",
        "webBrowser": "internet-explorer-4"
      }
    },

    "applications": [
      {
        "id": "my_computer",
        "name": "My Computer",
        "icon": "icons/my_computer.png",
        "type": "system",
        "component": "FileExplorer",

        "window": {
          "title": "My Computer",
          "width": 640,
          "height": 480,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        },

        "desktop": {
          "icon": true,
          "position": { "x": 0, "y": 0 }
        },

        "features": {
          "saveState": true,
          "multiInstance": true
        }
      },
      {
        "id": "recycle_bin",
        "name": "Recycle Bin",
        "icon": "icons/recycle_bin_empty.png",
        "type": "system",
        "component": "RecycleBin",

        "window": {
          "title": "Recycle Bin",
          "width": 640,
          "height": 480,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        },

        "desktop": {
          "icon": true,
          "position": { "x": 0, "y": 80 }
        }
      },
      {
        "id": "internet_explorer",
        "name": "Internet Explorer",
        "icon": "icons/ie4.png",
        "type": "web",
        "component": "InternetExplorer4",

        "window": {
          "title": "Microsoft Internet Explorer",
          "width": 800,
          "height": 600,
          "minWidth": 400,
          "minHeight": 300,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        },

        "desktop": {
          "icon": true,
          "position": { "x": 0, "y": 160 }
        },

        "features": {
          "multiInstance": true,
          "fileAssociations": [".html", ".htm"]
        }
      },
      {
        "id": "notepad",
        "name": "Notepad",
        "icon": "icons/notepad.png",
        "type": "productivity",
        "component": "Notepad",

        "window": {
          "title": "Untitled - Notepad",
          "width": 500,
          "height": 400,
          "minWidth": 300,
          "minHeight": 200,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "cascade"
        },

        "menu": {
          "path": "Accessories",
          "category": "Accessories"
        },

        "features": {
          "multiInstance": true,
          "fileAssociations": [".txt", ".log", ".ini"]
        }
      },
      {
        "id": "paint",
        "name": "Paint",
        "icon": "icons/paint.png",
        "type": "creative",
        "component": "Paint",

        "window": {
          "title": "Untitled - Paint",
          "width": 640,
          "height": 480,
          "minWidth": 400,
          "minHeight": 300,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "cascade"
        },

        "menu": {
          "path": "Accessories",
          "category": "Accessories"
        },

        "features": {
          "multiInstance": true,
          "fileAssociations": [".bmp", ".dib", ".gif", ".jpg"]
        }
      },
      {
        "id": "calculator",
        "name": "Calculator",
        "icon": "icons/calculator.png",
        "type": "utility",
        "component": "Calculator",

        "window": {
          "title": "Calculator",
          "width": 250,
          "height": 300,
          "resizable": false,
          "minimizable": true,
          "maximizable": false,
          "position": "center"
        },

        "menu": {
          "path": "Accessories",
          "category": "Accessories"
        },

        "features": {
          "multiInstance": false
        }
      },
      {
        "id": "minesweeper",
        "name": "Minesweeper",
        "icon": "icons/minesweeper.png",
        "type": "game",
        "component": "Minesweeper",

        "window": {
          "title": "Minesweeper",
          "width": 300,
          "height": 350,
          "resizable": false,
          "minimizable": true,
          "maximizable": false,
          "position": "center"
        },

        "menu": {
          "path": "Games",
          "category": "Games"
        }
      },
      {
        "id": "solitaire",
        "name": "Solitaire",
        "icon": "icons/solitaire.png",
        "type": "game",
        "component": "Solitaire",

        "window": {
          "title": "Solitaire",
          "width": 640,
          "height": 480,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        },

        "menu": {
          "path": "Games",
          "category": "Games"
        }
      },
      {
        "id": "media_player",
        "name": "Windows Media Player",
        "icon": "icons/media_player.png",
        "type": "media",
        "component": "MediaPlayer",

        "window": {
          "title": "Windows Media Player",
          "width": 400,
          "height": 300,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        },

        "menu": {
          "path": "Accessories/Entertainment",
          "category": "Entertainment"
        },

        "features": {
          "multiInstance": false,
          "fileAssociations": [".mp3", ".wav", ".avi"]
        }
      }
    ],

    "utilities": [
      {
        "id": "control_panel",
        "name": "Control Panel",
        "type": "control_panel",
        "icon": "icons/control_panel.png",
        "component": "ControlPanel"
      },
      {
        "id": "display_properties",
        "name": "Display Properties",
        "type": "system_preference",
        "icon": "icons/display.png",
        "component": "DisplayProperties"
      }
    ]
  },

  "features": {
    "interaction": {
      "dragAndDrop": true,
      "clipboard": true,
      "undo": true,

      "fileOperations": {
        "copy": true,
        "move": true,
        "delete": true,
        "rename": true,
        "properties": true
      },

      "networking": {
        "enabled": true,
        "protocols": ["TCP/IP", "NetBEUI", "IPX/SPX"]
      },

      "printing": true,
      "scanning": false
    },

    "animations": {
      "enabled": true,
      "speed": "normal",

      "effects": {
        "windowOpen": true,
        "windowClose": true,
        "windowMinimize": true,
        "minimize": true,
        "maximize": true,
        "menuOpen": true,
        "hover": false,
        "click": false,
        "transitions": false,
        "parallax": false
      }
    },

    "accessibility": {
      "highContrast": true,
      "screenReader": false,
      "magnifier": true,
      "keyboard_navigation": true
    },

    "easterEggs": {
      "enabled": true,
      "list": ["credits_beach", "hover_game"]
    },

    "customization": {
      "themes": true,
      "wallpaper": true,
      "colors": true,
      "fonts": false,
      "layout": true
    }
  },

  "assets": {
    "basePath": "/assets/os/windows98",

    "paths": {
      "icons": "icons",
      "cursors": "cursors",
      "sounds": "sounds",
      "fonts": "fonts",
      "wallpapers": "wallpapers"
    },

    "iconSets": {
      "default": {
        "path": "icons",
        "format": "png",
        "sizes": [16, 32, 48]
      }
    },

    "cursorSets": {
      "default": {
        "path": "cursors",
        "format": "cur",
        "animated": true
      }
    },

    "soundSets": {
      "default": {
        "path": "sounds",
        "format": "wav"
      }
    },

    "fonts": {
      "ms_sans_serif": {
        "path": "fonts/ms-sans-serif.woff2",
        "format": "woff2",
        "weights": [400, 700]
      },
      "courier_new": {
        "path": "fonts/courier-new.woff2",
        "format": "woff2",
        "weights": [400, 700]
      }
    },

    "preload": [
      "icons/my_computer.png",
      "icons/recycle_bin_empty.png",
      "icons/folder.png",
      "cursors/arrow.cur",
      "sounds/startup.wav"
    ]
  }
}
