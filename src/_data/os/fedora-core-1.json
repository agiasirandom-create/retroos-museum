    "releaseDate": "2003-11-06",
    "description": "Community-driven Linux distribution sponsored by Red Hat, featuring cutting-edge open source software and GNOME 2.4 desktop.",
    "tagline": "Freedom. Friends. Features. First.",
    "category": "desktop_linux",
    "architecture": ["x86", "x86_64"],
    "historical": {
      "significance": "First release of Fedora Project after Red Hat Linux split into RHEL and Fedora. Became testbed for Red Hat Enterprise Linux features.",
      "marketShare": "Popular among developers and early adopters",
      "successor": "Fedora continues development",
      "predecessor": "Red Hat Linux 9"
    },
    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/Fedora_Linux",
      "officialSite": "https://getfedora.org"
    }
  },
  "visual": {
