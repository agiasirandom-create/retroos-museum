      "style": {
        "type": "bevel_3d",
        "borderStyle": "bevel_out",
        "cornerRadius": 0,
        "shadows": false,
        "transparency": false,
        "bevels": true,
        "gradients": false,
        "animationStyle": "linear"
      }
