{
  "schema_version": "1.0.0",
  "os_id": "ipados-13",
  "metadata": {
    "name": "iPadOS 13",
    "fullName": "Apple iPadOS 13",
    "version": "13.0",
    "company": "Apple Inc.",
    "releaseYear": 2019,
    "releaseDate": "2019-09-24",
    "description": "First dedicated iPad OS with desktop-class browsing, enhanced multitasking, Apple Pencil improvements, and external drive support.",
    "tagline": "There's a computer in iPad",
    "category": "mobile_modern",
    "architecture": ["ARM64"],
    "historical": {
      "significance": "iPad gets its own OS identity, Split View improvements, desktop Safari, USB drive support, widget enhancements",
      "successor": "iPadOS 14",
      "predecessor": "iOS 12 (for iPad)"
    },
    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/IPadOS_13"
    }
  },
  "visual": {
    "theme": {
      "colors": {
        "desktop": "#FFFFFF",
        "windowBackground": "rgba(255, 255, 255, 0.98)",
        "titleBarActive": "rgba(247, 247, 247, 0.85)",
        "titleBarText": "#000000",
        "buttonFace": "#007AFF",
        "buttonText": "#FFFFFF",
        "highlight": "#007AFF",
        "text": "#000000",
        "statusBar": "transparent",
        "custom": {
          "slideOver": "rgba(255, 255, 255, 0.95)",
          "splitView": "rgba(255, 255, 255, 0.98)"
        }
      },
      "typography": {
        "systemFont": {
          "family": "San Francisco",
          "size": 17,
          "weight": "400"
        },
        "titleFont": {
          "family": "San Francisco",
          "size": 34,
          "weight": "700"
        },
        "antialiasing": true,
        "baseFontSize": 17,
        "scaleFactor": 2.0
      },
      "style": {
        "type": "flat",
        "transparency": true,
        "blur": true,
        "animationStyle": "ease"
      }
    },
    "icons": {
      "style": "flat_modern",
      "size": {
        "default": 60,
        "sizes": [60, 120, 180]
      },
      "rendering": "vector"
    },
    "wallpaper": {
      "type": "image",
      "value": "wallpapers/ipados-default.jpg"
    }
  },
  "paradigm": {
    "windowSystem": {
      "type": "hybrid",
      "behavior": {
        "overlap": true,
        "resize": true,
        "modal": true,
        "tabbed": true
      },
      "effects": {
        "blur": true
      }
    },
    "menuSystem": {
      "type": "context_only"
    },
    "taskManagement": {
      "type": "cards",
      "multitasking": {
        "preemptive": true,
        "splitScreen": true
      }
    },
    "desktop": {
      "type": "iconic",
      "layout": {
        "type": "grid"
      },
      "items": {
        "icons": true,
        "widgets": true,
        "folders": true
      }
    },
    "inputMethods": {
      "keyboard": {
        "shortcuts": true
      },
      "mouse": {
        "buttons": 2,
        "scroll": "wheel",
        "gestures": true
      },
      "touch": {
        "enabled": true,
        "multitouch": true,
        "gestures": ["tap", "swipe", "pinch", "multi_finger"]
      },
      "pen": {
        "enabled": true,
        "pressureLevels": 4096,
        "tilt": true
      }
    }
  },
  "components": {
    "core": {
      "windowManager": "springboard",
      "fileManager": "files",
      "optional": {
        "webBrowser": "safari"
      }
    }
  },
  "features": {
    "interaction": {
      "dragAndDrop": true,
      "clipboard": true,
      "networking": {
        "enabled": true,
        "protocols": ["WiFi", "LTE", "Bluetooth 5.0"]
      }
    },
    "animations": {
      "enabled": true,
      "effects": {
        "transitions": true,
        "parallax": true
      }
    },
    "customization": {
      "wallpaper": true,
      "layout": true
    }
  },
  "assets": {
    "basePath": "/assets/os/ipados-13",
    "paths": {
      "icons": "icons",
      "wallpapers": "wallpapers"
    }
  }
}
