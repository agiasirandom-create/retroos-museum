{
  "schema_version": "1.0.0",
  "os_id": "linux-fvwm",

  "metadata": {
    "name": "Linux with FVWM",
    "fullName": "Linux X11 with FVWM Window Manager",
    "version": "FVWM 2.0",
    "company": "Community Developed",
    "releaseYear": 1995,
    "releaseDate": "1995-01-01",
    "description": "Classic Unix workstation environment with the lightweight FVWM window manager, providing a customizable X11 desktop experience.",
    "tagline": "The Power of Open Source",
    "category": "desktop_linux",
    "architecture": ["x86", "Alpha", "SPARC", "MIPS"],

    "historical": {
      "significance": "Representative of classic Unix workstation environments. FVWM became one of the most popular lightweight window managers.",
      "marketShare": "Dominant in academic and technical environments in mid-1990s",
      "successor": "GNOME, KDE",
      "predecessor": "TWM, MWM"
    },

    "links": {
      "wikipedia": "https://en.wikipedia.org/wiki/FVWM"
    }
  },

  "visual": {
    "theme": {
      "colors": {
        "desktop": "#5F9EA0",

        "windowBackground": "#C0C0C0",
        "windowBorder": "#000000",
        "windowBorderWidth": 2,

        "titleBarActive": "#000080",
        "titleBarInactive": "#808080",
        "titleBarText": "#FFFFFF",
        "titleBarTextInactive": "#C0C0C0",

        "buttonFace": "#B0B0B0",
        "buttonText": "#000000",
        "buttonHighlight": "#E0E0E0",
        "buttonShadow": "#404040",

        "highlight": "#4682B4",
        "highlightText": "#FFFFFF",

        "menuBackground": "#B0B0B0",
        "menuText": "#000000",
        "menuHighlight": "#4682B4",

        "text": "#000000",

        "custom": {
          "pagerBackground": "#606060",
          "pagerActive": "#4682B4",
          "rootMenuBackground": "#A0A0A0"
        }
      },

      "typography": {
        "systemFont": {
          "family": "Helvetica",
          "size": 12,
          "weight": "normal",
          "fallback": ["Arial", "sans-serif"]
        },
        "titleFont": {
          "family": "Helvetica",
          "size": 10,
          "weight": "bold"
        },
        "menuFont": {
          "family": "Helvetica",
          "size": 10,
          "weight": "normal"
        },
        "monospaceFont": {
          "family": "Fixed",
          "size": 10,
          "weight": "normal"
        },

        "antialiasing": false,
        "baseFontSize": 12
      },

      "style": {
        "type": "bevel_3d",
        "borderStyle": "bevel_out",
        "cornerRadius": 0,

        "shadows": false,
        "transparency": false,

        "bevels": true,
        "gradients": false,

        "animationStyle": "instant"
      }
    },

    "cursor": {
      "style": "classic_arrow",
      "animated": false,
      "shadows": false
    },

    "icons": {
      "style": "icon_48",
      "size": {
        "default": 48,
        "sizes": [32, 48]
      },
      "rendering": "antialiased",
      "shadow": false,
      "labelStyle": {
        "position": "below",
        "background": "transparent",
        "textColor": "#FFFFFF",
        "font": {
          "family": "Helvetica",
          "size": 10
        }
      }
    },

    "wallpaper": {
      "type": "solid",
      "value": "#5F9EA0",
      "overlay": true
    }
  },

  "paradigm": {
    "windowSystem": {
      "type": "stacking",

      "behavior": {
        "overlap": true,
        "resize": true,
        "minimize": true,
        "maximize": true,
        "close": true,

        "modal": true,
        "alwaysOnTop": true,
        "transparency": false
      },

      "chrome": {
        "titleBar": "classic",
        "controls": "buttons",
        "controlPosition": "right",

        "buttons": {
          "minimize": {
            "style": "icon",
            "content": "minimize",
            "position": 1
          },
          "maximize": {
            "style": "icon",
            "content": "maximize",
            "position": 2
          },
          "close": {
            "style": "icon",
            "content": "close",
            "position": 3
          }
        },

        "titleAlign": "left",
        "showIcon": false
      },

      "effects": {
        "shadow": false
      }
    },

    "menuSystem": {
      "type": "context_only",

      "contextMenu": {
        "enabled": true,
        "trigger": "right_click",
        "style": {
          "background": "#A0A0A0",
          "borderStyle": "bevel_out"
        }
      },

      "behavior": {
        "clickToOpen": true,
        "icons": true,
        "cascading": true,
        "tearOff": true
      }
    },

    "taskManagement": {
      "type": "panel",

      "switching": {
        "method": ["alt_tab", "window_list"]
      },

      "multitasking": {
        "preemptive": true,
        "virtual_desktops": true
      }
    },

    "desktop": {
      "type": "iconic",

      "layout": {
        "type": "grid",
        "grid": {
          "cellWidth": 80,
          "cellHeight": 100,
          "spacing": 20
        },
        "direction": "vertical",
        "alignment": "left",
        "snapToGrid": true
      },

      "items": {
        "icons": true,
        "shortcuts": true,
        "folders": true
      },

      "interaction": {
        "click": "double",
        "selection": "rubber_band",
        "dragAndDrop": true
      }
    },

    "inputMethods": {
      "keyboard": {
        "shortcuts": true,
        "function_keys": true,
        "navigation": "arrows"
      },

      "mouse": {
        "buttons": 3,
        "scroll": "none",
        "gestures": false
      }
    }
  },

  "components": {
    "core": {
      "windowManager": "fvwm",
      "fileManager": "xfm",

      "optional": {
        "terminal": "xterm",
        "textEditor": "xedit"
      }
    },

    "applications": [
      {
        "id": "xterm",
        "name": "Terminal",
        "icon": "icons/xterm.png",
        "type": "system",
        "component": "XTerm",

        "window": {
          "title": "xterm",
          "width": 640,
          "height": 400,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "cascade"
        },

        "features": {
          "multiInstance": true
        }
      },
      {
        "id": "xedit",
        "name": "Text Editor",
        "icon": "icons/xedit.png",
        "type": "productivity",
        "component": "XEdit",

        "window": {
          "title": "xedit",
          "width": 500,
          "height": 400,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "cascade"
        },

        "features": {
          "multiInstance": true,
          "fileAssociations": [".txt", ".c", ".h"]
        }
      },
      {
        "id": "xcalc",
        "name": "Calculator",
        "icon": "icons/xcalc.png",
        "type": "utility",
        "component": "XCalc",

        "window": {
          "title": "xcalc",
          "width": 250,
          "height": 320,
          "resizable": false,
          "minimizable": true,
          "maximizable": false,
          "position": "center"
        }
      },
      {
        "id": "xfm",
        "name": "File Manager",
        "icon": "icons/folder.png",
        "type": "system",
        "component": "XFM",

        "window": {
          "title": "File Manager",
          "width": 600,
          "height": 450,
          "resizable": true,
          "minimizable": true,
          "maximizable": true,
          "position": "center"
        }
      }
    ]
  },

  "features": {
    "interaction": {
      "dragAndDrop": true,
      "clipboard": true,

      "fileOperations": {
        "copy": true,
        "move": true,
        "delete": true,
        "rename": true,
        "properties": true
      },

      "networking": {
        "enabled": true,
        "protocols": ["TCP/IP", "NFS"]
      }
    },

    "animations": {
      "enabled": false,
      "speed": "normal"
    },

    "customization": {
      "themes": true,
      "wallpaper": true,
      "colors": true,
      "layout": true
    }
  },

  "assets": {
    "basePath": "/assets/os/linux-fvwm",

    "paths": {
      "icons": "icons",
      "cursors": "cursors",
      "fonts": "fonts"
    },

    "iconSets": {
      "default": {
        "path": "icons",
        "format": "png",
        "sizes": [32, 48]
      }
    }
  }
}
