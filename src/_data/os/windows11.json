{
  "schema_version": "1.0.0",
  "os_id": "windows-11",
  "metadata": {
    "name": "Windows 11",
    "fullName": "Microsoft Windows 11",
    "version": "10.0.22000",
    "company": "Microsoft Corporation",
    "releaseYear": 2021,
    "releaseDate": "2021-10-05",
    "description": "Modern redesign with centered taskbar, rounded corners, Fluent Design, and enhanced productivity features.",
    "tagline": "Brings You Closer to What You Love",
    "category": "desktop_windows",
    "architecture": ["x64", "ARM64"],
    "historical": {
      "significance": "First major redesign since Windows 8, centered UI, integrated Teams, Android app support, strict hardware requirements",
      "marketShare": "Growing adoption, coexisting with Windows 10",
      "successor": null,
      "predecessor": "Windows 10",
      "endOfLife": null
    },
    "links": {"wikipedia": "https://en.wikipedia.org/wiki/Windows_11"}
  },
  "visual": {
    "theme": {
      "colors": {
        "desktop": "#1E1E1E",
        "windowBackground": "#F3F3F3",
        "windowBorder": "#E0E0E0",
        "windowBorderWidth": 1,
        "titleBarActive": "#F3F3F3",
        "titleBarInactive": "#F8F8F8",
        "titleBarText": "#000000",
        "titleBarTextInactive": "#757575",
        "buttonFace": "#F3F3F3",
        "buttonText": "#000000",
        "buttonHighlight": "#E6E6E6",
        "buttonShadow": "#D0D0D0",
        "buttonBorder": "#0078D4",
        "highlight": "#0078D4",
        "highlightText": "#FFFFFF",
        "menuBackground": "#F9F9F9",
        "menuText": "#000000",
        "text": "#000000",
        "taskbar": "rgba(243, 243, 243, 0.9)",
        "shadow": "rgba(0, 0, 0, 0.15)"
      },
      "typography": {
        "systemFont": {"family": "Segoe UI Variable", "size": 12, "weight": "400", "fallback": ["Segoe UI", "Arial", "sans-serif"]},
        "titleFont": {"family": "Segoe UI Variable", "size": 12, "weight": "600"},
        "menuFont": {"family": "Segoe UI Variable", "size": 12, "weight": "400"},
        "monospaceFont": {"family": "Cascadia Code", "size": 10, "weight": "normal"},
        "antialiasing": true,
        "subpixelRendering": true,
        "baseFontSize": 12,
        "scaleFactor": 1.0
      },
      "style": {
        "type": "fluent",
        "borderStyle": "shadow",
        "cornerRadius": 12,
        "shadows": true,
        "shadowStyle": "soft",
        "transparency": true,
        "blur": true,
        "bevels": false,
        "gradients": true,
        "textures": false,
        "animationStyle": "ease"
      },
      "specialElements": {"scrollbarStyle": "overlay", "focusIndicator": "solid_outline", "dragVisual": "full"}
    },
    "cursor": {"style": "modern_arrow", "animated": true, "shadows": false},
    "icons": {
      "style": "fluent",
      "size": {"default": 48, "sizes": [16, 32, 48, 256]},
      "rendering": "vector",
      "shadow": true,
      "labelStyle": {"position": "below", "background": "solid", "backgroundColor": "rgba(0, 0, 0, 0.4)", "textColor": "#FFFFFF", "font": {"family": "Segoe UI Variable", "size": 9}}
    },
    "sounds": {
      "enabled": true,
      "sounds": {"startup": "sounds/startup.wav", "shutdown": "sounds/shutdown.wav", "notification": "sounds/notify.wav"},
      "volume": 80
    },
    "wallpaper": {"type": "image", "value": "wallpapers/bloom.jpg", "tiling": "stretch", "overlay": true}
  },
  "paradigm": {
    "windowSystem": {
      "type": "stacking",
      "behavior": {"overlap": true, "resize": true, "minimize": true, "maximize": true, "close": true, "modal": true, "alwaysOnTop": true, "transparency": true, "multipleDocuments": false, "tabbed": true, "tiling": true},
      "chrome": {
        "titleBar": "unified",
        "controls": "buttons",
        "controlPosition": "right",
        "buttons": {
          "minimize": {"style": "icon", "content": "minimize", "position": 1},
          "maximize": {"style": "icon", "content": "maximize", "position": 2},
          "close": {"style": "icon", "content": "close", "position": 3, "hoverColor": "#C42B1C"}
        },
        "titleAlign": "center",
        "showIcon": true,
        "showPath": false
      },
      "effects": {"openAnimation": "zoom", "closeAnimation": "fade", "minimizeAnimation": "scale", "shadow": true, "blur": true}
    },
    "menuSystem": {
      "type": "hybrid",
      "menuBar": {"enabled": true, "position": "window", "style": {"background": "#F9F9F9", "textColor": "#000000", "height": 32}},
      "contextMenu": {"enabled": true, "trigger": "right_click", "style": {"background": "rgba(252, 252, 252, 0.95)", "borderStyle": "shadow"}},
      "behavior": {"clickToOpen": true, "keyboardShortcuts": true, "icons": true, "cascading": true}
    },
    "taskManagement": {
      "type": "taskbar",
      "taskbar": {
        "enabled": true,
        "position": "bottom",
        "autoHide": false,
        "size": 48,
        "style": {"background": "rgba(243, 243, 243, 0.9)", "transparency": true, "blur": true, "itemStyle": "icons", "grouping": true, "previews": true},
        "sections": {"start": true, "quick_launch": false, "tasks": true, "system_tray": true, "clock": true}
      },
      "switching": {"method": ["alt_tab", "taskbar_click"], "altTab": {"enabled": true, "visual": "thumbnails", "animation": true}, "expose": {"enabled": true, "layout": "grid"}},
      "multitasking": {"preemptive": true, "virtual_desktops": true, "snapAssist": true, "splitScreen": true}
    },
    "desktop": {
      "type": "iconic",
      "layout": {"type": "grid", "grid": {"cellWidth": 80, "cellHeight": 100, "spacing": 12}, "direction": "vertical", "alignment": "left", "snapToGrid": true, "autoArrange": false},
      "items": {"icons": true, "widgets": true, "shortcuts": true, "folders": true, "defaultItems": ["this_pc", "recycle_bin"]},
      "interaction": {"click": "double", "selection": "rubber_band", "dragAndDrop": true, "hoverPreview": true},
      "behavior": {"showTrash": true, "showComputer": true, "showNetwork": false}
    },
    "inputMethods": {
      "keyboard": {"shortcuts": true, "function_keys": true, "navigation": "arrows", "accessibility": true},
      "mouse": {"buttons": 5, "scroll": "wheel", "gestures": false, "acceleration": true},
      "touch": {"enabled": true, "multitouch": true, "gestures": ["tap", "swipe", "pinch", "rotate"], "pressureSensitive": false},
      "pen": {"enabled": true, "pressureLevels": 4096, "tilt": true, "eraser": true}
    }
  },
  "components": {
    "core": {
      "windowManager": "windows11-window-manager",
      "fileManager": "file-explorer",
      "optional": {"taskbar": "windows11-taskbar", "terminal": "windows-terminal", "textEditor": "notepad", "mediaPlayer": "media-player", "webBrowser": "microsoft-edge"}
    },
    "applications": [
      {"id": "this_pc", "name": "This PC", "icon": "icons/this_pc.png", "type": "system", "component": "FileExplorer", "window": {"title": "File Explorer", "width": 1100, "height": 750, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}, "desktop": {"icon": true, "position": {"x": 0, "y": 0}}},
      {"id": "recycle_bin", "name": "Recycle Bin", "icon": "icons/recycle_bin_empty.png", "type": "system", "component": "RecycleBin", "window": {"title": "Recycle Bin", "width": 1100, "height": 750, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}, "desktop": {"icon": true, "position": {"x": 0, "y": 100}}},
      {"id": "edge", "name": "Microsoft Edge", "icon": "icons/edge.png", "type": "web", "component": "Edge", "window": {"title": "Microsoft Edge", "width": 1300, "height": 850, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "notepad", "name": "Notepad", "icon": "icons/notepad.png", "type": "productivity", "component": "Notepad", "window": {"title": "Notepad", "width": 850, "height": 700, "resizable": true, "minimizable": true, "maximizable": true, "position": "cascade"}},
      {"id": "calculator", "name": "Calculator", "icon": "icons/calculator.png", "type": "utility", "component": "Calculator", "window": {"title": "Calculator", "width": 380, "height": 550, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "photos", "name": "Photos", "icon": "icons/photos.png", "type": "media", "component": "Photos", "window": {"title": "Photos", "width": 1100, "height": 800, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "paint", "name": "Paint", "icon": "icons/paint.png", "type": "creative", "component": "Paint", "window": {"title": "Paint", "width": 1000, "height": 750, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "terminal", "name": "Windows Terminal", "icon": "icons/terminal.png", "type": "developer", "component": "Terminal", "window": {"title": "Windows Terminal", "width": 1000, "height": 600, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}}
    ],
    "utilities": [
      {"id": "settings", "name": "Settings", "type": "system_preference", "icon": "icons/settings.png"},
      {"id": "widgets", "name": "Widgets", "type": "system_preference", "icon": "icons/widgets.png"},
      {"id": "snap_layouts", "name": "Snap Layouts", "type": "system_preference", "icon": "icons/snap.png"}
    ]
  },
  "features": {
    "interaction": {"dragAndDrop": true, "clipboard": true, "undo": true, "fileOperations": {"copy": true, "move": true, "delete": true, "rename": true, "properties": true}, "networking": {"enabled": true, "protocols": ["TCP/IP", "IPv6", "Bluetooth"]}, "printing": true, "scanning": true},
    "animations": {"enabled": true, "speed": "normal", "effects": {"windowOpen": true, "windowClose": true, "windowMinimize": true, "minimize": true, "maximize": true, "menuOpen": true, "hover": true, "click": true, "transitions": true, "parallax": true}},
    "accessibility": {"highContrast": true, "screenReader": true, "magnifier": true, "keyboard_navigation": true, "colorblindModes": ["protanopia", "deuteranopia", "tritanopia"]},
    "easterEggs": {"enabled": false, "list": []},
    "customization": {"themes": true, "wallpaper": true, "colors": true, "fonts": true, "layout": true}
  },
  "assets": {
    "basePath": "/assets/os/windows11",
    "paths": {"icons": "icons", "cursors": "cursors", "sounds": "sounds", "fonts": "fonts", "wallpapers": "wallpapers"},
    "iconSets": {"default": {"path": "icons", "format": "svg", "sizes": [16, 32, 48, 256]}},
    "fonts": {
      "segoe_ui_variable": {"path": "fonts/segoe-ui-variable.woff2", "format": "woff2", "weights": [300, 400, 600, 700]},
      "cascadia_code": {"path": "fonts/cascadia-code.woff2", "format": "woff2", "weights": [400, 600]}
    },
    "preload": ["icons/this_pc.png", "sounds/startup.wav", "wallpapers/bloom.jpg"]
  }
}
