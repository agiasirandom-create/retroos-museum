          "position": "center"
        },
        "desktop": {
          "icon": true,
          "position": { "x": 74, "y": 0 }
        }
      },
      {
        "id": "phone",
        "name": "Phone",
        "icon": "icons/phone.png",
        "type": "communication",
        "component": "Phone",
        "window": {
          "title": "Phone",
          "width": 320,
          "height": 480,
          "resizable": false,
          "position": "center"
        },
        "desktop": {
          "icon": true,
          "position": { "x": 148, "y": 0 }
        }
      },
      {
        "id": "ipod",
        "name": "iPod",
        "icon": "icons/ipod.png",
        "type": "media",
        "component": "iPod",
        "window": {
          "title": "iPod",
          "width": 320,
          "height": 480,
          "resizable": false,
          "position": "center"
        },
        "desktop": {
          "icon": true,
