  "features": {
    "interaction": {
      "dragAndDrop": false,
      "clipboard": true,
      "undo": false,

      "fileOperations": {
        "copy": false,
        "move": false,
        "delete": false,
        "rename": false,
        "properties": false
      },

      "networking": {
        "enabled": true,
        "protocols": ["WiFi", "EDGE"]
      },

      "printing": false,
      "scanning": false
    },

    "animations": {
      "enabled": true,
      "speed": "normal",

      "effects": {
