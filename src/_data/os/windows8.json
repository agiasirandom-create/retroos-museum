{
  "schema_version": "1.0.0",
  "os_id": "windows-8",
  "metadata": {
    "name": "Windows 8",
    "fullName": "Microsoft Windows 8",
    "version": "6.2.9200",
    "company": "Microsoft Corporation",
    "releaseYear": 2012,
    "releaseDate": "2012-10-26",
    "description": "Bold redesign with Metro interface, full-screen Start screen, and touch-first design that divided users.",
    "tagline": "Reimagine Windows",
    "category": "desktop_windows",
    "architecture": ["x86", "x64", "ARM"],
    "historical": {
      "significance": "Radical Metro UI redesign for touch, removed Start Menu, unified desktop and tablet experience",
      "marketShare": "Controversial reception, quickly superseded by Windows 8.1 and 10",
      "successor": "Windows 10",
      "predecessor": "Windows 7",
      "endOfLife": "2016-01-12"
    },
    "links": {"wikipedia": "https://en.wikipedia.org/wiki/Windows_8"}
  },
  "visual": {
    "theme": {
      "colors": {
        "desktop": "#000000",
        "windowBackground": "#FFFFFF",
        "windowBorder": "#0078D7",
        "windowBorderWidth": 1,
        "titleBarActive": "#0078D7",
        "titleBarInactive": "#CCCCCC",
        "titleBarText": "#FFFFFF",
        "titleBarTextInactive": "#666666",
        "buttonFace": "#FFFFFF",
        "buttonText": "#000000",
        "buttonHighlight": "#E6E6E6",
        "buttonShadow": "#CCCCCC",
        "buttonBorder": "#0078D7",
        "highlight": "#0078D7",
        "highlightText": "#FFFFFF",
        "menuBackground": "#FFFFFF",
        "menuText": "#000000",
        "text": "#000000",
        "taskbar": "#1E1E1E",
        "shadow": "rgba(0, 0, 0, 0.3)"
      },
      "typography": {
        "systemFont": {"family": "Segoe UI", "size": 12, "weight": "300", "fallback": ["Arial", "sans-serif"]},
        "titleFont": {"family": "Segoe UI", "size": 12, "weight": "400"},
        "menuFont": {"family": "Segoe UI", "size": 12, "weight": "300"},
        "monospaceFont": {"family": "Consolas", "size": 10, "weight": "normal"},
        "antialiasing": true,
        "subpixelRendering": true,
        "baseFontSize": 12,
        "scaleFactor": 1.0
      },
      "style": {
        "type": "metro",
        "borderStyle": "single",
        "cornerRadius": 0,
        "shadows": false,
        "transparency": false,
        "blur": false,
        "bevels": false,
        "gradients": false,
        "textures": false,
        "animationStyle": "ease"
      },
      "specialElements": {"scrollbarStyle": "thin", "focusIndicator": "solid_outline", "dragVisual": "full"}
    },
    "cursor": {"style": "modern_arrow", "animated": true, "shadows": false},
    "icons": {
      "style": "flat_modern",
      "size": {"default": 48, "sizes": [16, 32, 48, 256]},
      "rendering": "vector",
      "shadow": false,
      "labelStyle": {"position": "below", "background": "transparent", "textColor": "#FFFFFF", "font": {"family": "Segoe UI", "size": 9}}
    },
    "sounds": {
      "enabled": true,
      "sounds": {"startup": "sounds/startup.wav", "shutdown": "sounds/shutdown.wav", "notification": "sounds/notify.wav"},
      "volume": 80
    },
    "wallpaper": {"type": "solid", "value": "#000000", "tiling": "stretch", "overlay": true}
  },
  "paradigm": {
    "windowSystem": {
      "type": "hybrid",
      "behavior": {"overlap": true, "resize": true, "minimize": true, "maximize": true, "close": true, "modal": true, "alwaysOnTop": true, "transparency": false, "multipleDocuments": false, "tabbed": false, "tiling": true},
      "chrome": {
        "titleBar": "minimal",
        "controls": "buttons",
        "controlPosition": "right",
        "buttons": {
          "minimize": {"style": "icon", "content": "minimize", "position": 1},
          "maximize": {"style": "icon", "content": "maximize", "position": 2},
          "close": {"style": "icon", "content": "close", "position": 3, "hoverColor": "#E81123"}
        },
        "titleAlign": "left",
        "showIcon": true,
        "showPath": false
      },
      "effects": {"openAnimation": "slide", "closeAnimation": "fade", "shadow": false, "blur": false}
    },
    "menuSystem": {
      "type": "hybrid",
      "menuBar": {"enabled": true, "position": "window", "style": {"background": "#FFFFFF", "textColor": "#000000", "height": 24}},
      "contextMenu": {"enabled": true, "trigger": "right_click", "style": {"background": "#FFFFFF", "borderStyle": "single"}},
      "behavior": {"clickToOpen": true, "keyboardShortcuts": true, "icons": true, "cascading": true}
    },
    "taskManagement": {
      "type": "taskbar",
      "taskbar": {
        "enabled": true,
        "position": "bottom",
        "autoHide": false,
        "size": 40,
        "style": {"background": "#1E1E1E", "transparency": false, "blur": false, "itemStyle": "icons", "grouping": true, "previews": true},
        "sections": {"start": true, "quick_launch": false, "tasks": true, "system_tray": true, "clock": true}
      },
      "switching": {"method": ["alt_tab", "taskbar_click"], "altTab": {"enabled": true, "visual": "thumbnails", "animation": true}},
      "multitasking": {"preemptive": true, "virtual_desktops": false, "snapAssist": true, "splitScreen": true}
    },
    "desktop": {
      "type": "clean",
      "layout": {"type": "grid", "grid": {"cellWidth": 150, "cellHeight": 150, "spacing": 10}, "direction": "horizontal", "alignment": "left", "snapToGrid": false, "autoArrange": false},
      "items": {"icons": false, "widgets": true, "shortcuts": true, "folders": false, "defaultItems": []},
      "interaction": {"click": "single", "selection": "single", "dragAndDrop": true, "hoverPreview": false},
      "behavior": {"showTrash": false, "showComputer": false, "showNetwork": false}
    },
    "inputMethods": {
      "keyboard": {"shortcuts": true, "function_keys": true, "navigation": "arrows", "accessibility": true},
      "mouse": {"buttons": 5, "scroll": "wheel", "gestures": false, "acceleration": true},
      "touch": {"enabled": true, "multitouch": true, "gestures": ["tap", "swipe", "pinch"]}
    }
  },
  "components": {
    "core": {
      "windowManager": "windows8-window-manager",
      "fileManager": "windows-explorer-8",
      "optional": {"taskbar": "windows8-taskbar", "terminal": "command-prompt", "textEditor": "notepad", "mediaPlayer": "xbox-music", "webBrowser": "internet-explorer-10"}
    },
    "applications": [
      {"id": "file_explorer", "name": "File Explorer", "icon": "icons/file_explorer.png", "type": "system", "component": "FileExplorer", "window": {"title": "File Explorer", "width": 1000, "height": 700, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "internet_explorer", "name": "Internet Explorer", "icon": "icons/ie10.png", "type": "web", "component": "InternetExplorer10", "window": {"title": "Internet Explorer", "width": 1200, "height": 800, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}},
      {"id": "notepad", "name": "Notepad", "icon": "icons/notepad.png", "type": "productivity", "component": "Notepad", "window": {"title": "Notepad", "width": 750, "height": 600, "resizable": true, "minimizable": true, "maximizable": true, "position": "cascade"}},
      {"id": "calculator", "name": "Calculator", "icon": "icons/calculator.png", "type": "utility", "component": "Calculator", "window": {"title": "Calculator", "width": 400, "height": 500, "resizable": false, "minimizable": true, "maximizable": false, "position": "center"}},
      {"id": "photos", "name": "Photos", "icon": "icons/photos.png", "type": "media", "component": "Photos", "window": {"title": "Photos", "width": 900, "height": 700, "resizable": true, "minimizable": true, "maximizable": true, "position": "center"}}
    ],
    "utilities": [
      {"id": "settings", "name": "PC Settings", "type": "system_preference", "icon": "icons/settings.png"}
    ]
  },
  "features": {
    "interaction": {"dragAndDrop": true, "clipboard": true, "undo": true, "fileOperations": {"copy": true, "move": true, "delete": true, "rename": true, "properties": true}, "networking": {"enabled": true, "protocols": ["TCP/IP", "IPv6"]}, "printing": true, "scanning": true},
    "animations": {"enabled": true, "speed": "fast", "effects": {"windowOpen": true, "windowClose": true, "windowMinimize": true, "minimize": true, "maximize": true, "menuOpen": true, "hover": true, "click": true, "transitions": true}},
    "accessibility": {"highContrast": true, "screenReader": true, "magnifier": true, "keyboard_navigation": true},
    "easterEggs": {"enabled": false, "list": []},
    "customization": {"themes": true, "wallpaper": true, "colors": true, "fonts": false, "layout": true}
  },
  "assets": {
    "basePath": "/assets/os/windows8",
    "paths": {"icons": "icons", "cursors": "cursors", "sounds": "sounds", "fonts": "fonts", "wallpapers": "wallpapers"},
    "iconSets": {"default": {"path": "icons", "format": "svg", "sizes": [16, 32, 48, 256]}},
    "fonts": {"segoe_ui": {"path": "fonts/segoe-ui.woff2", "format": "woff2", "weights": [300, 400, 600, 700]}},
    "preload": ["icons/file_explorer.png", "sounds/startup.wav"]
  }
