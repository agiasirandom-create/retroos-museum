          <div class="os-card-header">
            <div class="os-icon" data-family="{{ os.family }}">
              <span class="icon-placeholder">{{ os.name | truncate(2, true, "") | upper }}</span>
            </div>
            <div class="os-badges">
              <span class="badge badge-family badge-{{ os.family }}">{{ os.family }}</span>
              <span class="badge badge-type">{{ os.type }}</span>
            </div>
          </div>

          <div class="os-card-body">
            <h3 class="os-name">{{ os.name }}</h3>
            <div class="os-meta">
              <span class="os-year">{{ os.year }}</span>
              <span class="meta-divider">•</span>
              <span class="os-company">{{ os.company }}</span>
            </div>
            <p class="os-description">{{ os.description | truncate(120) }}</p>

            <div class="os-features">
              {% for feature in os.features | slice(0, 3) %}
              <span class="feature-tag">{{ feature }}</span>
              {% endfor %}
            </div>
          </div>

          <div class="os-card-footer">
            <button class="os-details-btn" data-os-id="{{ os.id }}">
              View Details →
            </button>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
  </div>

  <!-- Back to Top Button -->
  <button id="back-to-top" class="back-to-top" aria-label="Back to top">
    ↑
  </button>
</div>

<!-- OS Details Modal (placeholder for future) -->
<div id="os-modal" class="modal" hidden>
  <div class="modal-content">
    <button class="modal-close" aria-label="Close modal">&times;</button>
    <div id="modal-body"></div>
  </div>
</div>

<link rel="stylesheet" href="/assets/css/timeline.css">
<script src="/assets/js/timeline.js"></script>
