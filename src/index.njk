    <button class="decade-btn active" data-decade="all">
      <span class="decade-label">All</span>
      <span class="decade-count">94</span>
    </button>
    <button class="decade-btn" data-decade="1980s">
      <span class="decade-label">1980s</span>
      <span class="decade-count">17</span>
    </button>
    <button class="decade-btn" data-decade="1990s">
      <span class="decade-label">1990s</span>
      <span class="decade-count">24</span>
    </button>
    <button class="decade-btn" data-decade="2000s">
      <span class="decade-label">2000s</span>
      <span class="decade-count">18</span>
    </button>
    <button class="decade-btn" data-decade="2010s">
      <span class="decade-label">2010s</span>
      <span class="decade-count">15</span>
    </button>
    <button class="decade-btn" data-decade="2020s">
      <span class="decade-label">2020s</span>
      <span class="decade-count">27</span>
    </button>
  </nav>

  <!-- Filter and Search Bar -->
  <section class="filter-section">
    <div class="search-container">
      <label for="os-search" class="sr-only">Search operating systems</label>
      <input
        type="search"
        id="os-search"
        class="search-input"
        placeholder="Search by name, company, or year..."
        aria-label="Search operating systems"
      />
      <span class="search-icon">🔍</span>
    </div>

    <div class="filter-controls">
      <div class="filter-group">
        <label for="family-filter">Family:</label>
        <select id="family-filter" class="filter-select">
          <option value="all">All Families</option>
          <option value="windows">Windows</option>
          <option value="macos">macOS</option>
          <option value="ios">iOS/iPadOS</option>
          <option value="linux">Linux</option>
          <option value="unix">Unix</option>
          <option value="bsd">BSD</option>
          <option value="dos">DOS</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="type-filter">Type:</label>
        <select id="type-filter" class="filter-select">
          <option value="all">All Types</option>
          <option value="desktop">Desktop</option>
          <option value="mobile">Mobile</option>
          <option value="server">Server</option>
          <option value="workstation">Workstation</option>
          <option value="tablet">Tablet</option>
          <option value="gaming">Gaming</option>
        </select>
      </div>

      <button id="clear-filters" class="clear-btn">Clear All</button>
    </div>

    <div class="results-info">
      Showing <span id="results-count">94</span> operating systems
    </div>
  </section>

  <!-- Timeline Visualization -->
  <div class="timeline-main">
    <!-- 1980s Section -->
    <section class="decade-section" data-decade="1980s" id="section-1980s">
      <div class="decade-header">
        <h2 class="decade-title">
          <span class="decade-number">1980s</span>
          <span class="era-name">The Early Personal Computer Era</span>
        </h2>
        <p class="decade-description">
          Birth of personal computing with DOS, early Mac systems, and Unix variants.
          The foundation era where command-line interfaces gave way to the first graphical user interfaces.
        </p>
        <div class="decade-stats">
          <span class="stat">17 Operating Systems</span>
          <span class="stat-divider">•</span>
          <span class="stat">Key Innovation: GUI Revolution</span>
        </div>
      </div>

      <div class="os-grid">
        {% for os in os1980s.operating_systems %}
        <article class="os-card"
                 data-os-id="{{ os.id }}"
                 data-decade="{{ os.decade }}"
                 data-family="{{ os.family }}"
                 data-type="{{ os.type }}"
                 data-year="{{ os.year }}"
                 data-company="{{ os.company | lower }}">
          <div class="os-card-header">
            <div class="os-icon" data-family="{{ os.family }}">
              <span class="icon-placeholder">{{ os.name | truncate(2, true, "") | upper }}</span>
            </div>
            <div class="os-badges">
              <span class="badge badge-family badge-{{ os.family }}">{{ os.family }}</span>
              <span class="badge badge-type">{{ os.type }}</span>
            </div>
          </div>

          <div class="os-card-body">
            <h3 class="os-name">{{ os.name }}</h3>
            <div class="os-meta">
              <span class="os-year">{{ os.year }}</span>
              <span class="meta-divider">•</span>
              <span class="os-company">{{ os.company }}</span>
            </div>
            <p class="os-description">{{ os.description | truncate(120) }}</p>

            <div class="os-features">
              {% for feature in os.features | slice(0, 3) %}
              <span class="feature-tag">{{ feature }}</span>
              {% endfor %}
            </div>
          </div>

          <div class="os-card-footer">
            <button class="os-details-btn" data-os-id="{{ os.id }}">
              View Details →
            </button>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>

