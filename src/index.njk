      <div class="featured-cta-group">
        <a href="/demos/" class="featured-cta-primary">
          🎨 Explore Demo Gallery
        </a>
        <a href="/docs/COMPONENT_LIBRARY_GUIDE.html" class="featured-cta-secondary">
          📚 Documentation
        </a>
      </div>
    </div>

